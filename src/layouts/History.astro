---
// One robot's page. Every file in src/content/history names this layout in its frontmatter.
import type { MarkdownLayoutProps } from 'astro';
import { getCollection } from 'astro:content';
import type { LinkType, YoutubeLinkType } from '@types';
import Hero from '@components/redesign/Hero.astro';

type Props = MarkdownLayoutProps<{
  title: string;
  year: number;
  photo: string;
  source?: string;
  flickr?: string;
  cad?: string;
  youtube_links?: YoutubeLinkType[];
  awards?: string[];
  links?: LinkType[];
}>;

const { frontmatter: robot } = Astro.props;
const awards = robot.awards ?? [];
const robots = (await getCollection('history')).sort((a, b) => a.data.year - b.data.year);
const index = robots.findIndex((entry) => entry.data.year === Number(robot.year));
const before = robots[index - 1];
const after = robots[index + 1];

// The first YouTube video that is a single video (not a playlist) is shown on the page.
const videoId = (robot.youtube_links ?? [])
  .map((link) => link.url.match(/(?:embed\/|watch\?v=|youtu\.be\/)([\w-]{11})/)?.[1])
  .find(Boolean);

const links = [
  robot.source && { name: 'Source code', url: robot.source },
  robot.cad && { name: 'CAD', url: robot.cad },
  robot.flickr && { name: 'Photos on Flickr', url: robot.flickr },
  ...(robot.youtube_links ?? []).map((link) => ({ name: link.name, url: link.url.replace('/embed/', '/watch?v=') })),
  { name: 'The Blue Alliance', url: `https://www.thebluealliance.com/team/694/${robot.year}` },
  ...(robot.links ?? []),
].filter(Boolean) as LinkType[];
const wins = awards.filter((award) => /winner/i.test(award)).length;
const stickers = [String(robot.year), awards.length ? `${awards.length} award${awards.length === 1 ? '' : 's'}` : '', wins ? `${wins} win${wins === 1 ? '' : 's'}` : ''].filter(Boolean);
---

<Hero title={robot.title} intro={`Our ${robot.year} robot.`} photo={robot.photo} photoAlt={`${robot.title}, our ${robot.year} robot`} stickers={stickers}>
  <a slot="before" class="back" href="/about/history">All robots</a>
  <ul slot="after" class="links">
    {links.map((link) => <li><a href={link.url} target="_blank" rel="noopener">{link.name}</a></li>)}
  </ul>
</Hero>

<div class="band body">
  {awards.length > 0 && (
    <section aria-labelledby="awards">
      <h2 id="awards" class="band-title">Awards</h2>
      <ul class="awards">
        {awards.map((award) => <li class:list={{ win: /winner/i.test(award) }}>{award}</li>)}
      </ul>
    </section>
  )}

  <div class="story prose">
    <slot />
  </div>

  {videoId && (
    <div class="video">
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${videoId}`}
        title={`${robot.title} video`}
        loading="lazy"
        allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen></iframe>
    </div>
  )}

  <nav class="next" aria-label="Other robots">
    {before ? <a href={`/about/history/${before.slug}`}><span>{before.data.year}</span><b>{before.data.title}</b></a> : <span />}
    {after ? <a class="later" href={`/about/history/${after.slug}`}><span>{after.data.year}</span><b>{after.data.title}</b></a> : <span />}
  </nav>
</div>

<style>
  .back {
    display: inline-block;
    margin-bottom: 18px;
    color: #fff;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .links {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .links a {
    display: inline-block;
    padding: 9px 16px;
    border-radius: 999px;
    color: #fff;
    font-weight: 600;
    font-size: 16px;
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.7);
  }
  .links a:hover {
    background: rgba(255, 255, 255, 0.14);
  }
  .body {
    max-width: 1120px;
  }
  .awards {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .awards li {
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--blush);
    font-weight: 600;
    font-size: 17px;
  }
  .awards li.win {
    background: var(--red);
    color: #fff;
  }
  .story {
    margin-top: 48px;
  }
  .story:empty {
    display: none;
  }
  .video {
    margin-top: 48px;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--ink);
  }
  .video iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .next {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 64px;
  }
  .next a {
    display: flex;
    flex-direction: column;
    padding: 22px 26px;
    border-radius: var(--radius-md);
    background: var(--blush);
    color: var(--ink);
  }
  .next a:hover {
    color: var(--red);
  }
  .next .later {
    text-align: right;
  }
  .next span {
    color: var(--soft);
    font-size: 15px;
  }
  .next b {
    font-size: 22px;
  }
  @media (max-width: 640px) {
    .next {
      grid-template-columns: 1fr;
    }
    .next .later {
      text-align: left;
    }
  }
</style>
