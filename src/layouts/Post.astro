---
import type { MarkdownLayoutProps } from "astro";
import { getCollection } from "astro:content";

type Props = MarkdownLayoutProps<{
  title: string;
  author: string;
  link: string;
  date: Date;
  file: string;
}>;

const { frontmatter } = Astro.props;
let splitPath = frontmatter.file.split(/content|.md/);
const sourcePath = splitPath[1];
const entry = (await getCollection("news")).find((post) => "/news/" + post.id.replace(/\.mdx?$/, "") === sourcePath);
const filePath = entry ? "/news/" + entry.slug + "/" : sourcePath;

let postDate = new Date(frontmatter.date);
const dateString = postDate.toLocaleDateString("en-us", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "2-digit",
});
---

<h3><a href={filePath}>&raquo; {frontmatter.title}</a></h3>
<p>By {frontmatter.author} on {dateString}</p>
<slot />
