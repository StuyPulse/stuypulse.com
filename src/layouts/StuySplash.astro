---
// One year of StuySplash talks. Every file in src/content/stuysplash names this layout in its frontmatter.
import type { MarkdownLayoutProps } from "astro";
import type { PresentationType } from "@types";
import PageHead from "@components/redesign/PageHead.astro";

type Props = MarkdownLayoutProps<{
  year: number;
  presentations: PresentationType[];
  playlist?: string | null;
}>;

const { frontmatter } = Astro.props;
const talks = frontmatter.presentations ?? [];
---

<PageHead title={`StuySplash ${frontmatter.year}`} intro={`${talks.length} talks from StuySplash ${frontmatter.year}.`}>
  <a slot="before" class="back" href="/resources/stuysplash">StuySplash</a>
  {frontmatter.playlist && (
    <div class="actions"><a class="pill pill-white" href={frontmatter.playlist}>Watch the recordings</a></div>
  )}
</PageHead>

<div class="band talks">
  <div class="prose"><slot /></div>
  <ul>
    {talks.map((talk) => (
      <li>
        <h2>{talk.title}</h2>
        <p class="who">{talk.presenter}</p>
        {talk.description && <p class="what">{talk.description}</p>}
        {talk.url && <a class="pill pill-line" href={talk.url}>Slides</a>}
      </li>
    ))}
  </ul>
</div>

<style>
  .back {
    display: inline-block;
    margin-bottom: 18px;
    color: #fff;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .talks {
    max-width: 1120px;
  }
  .prose:empty {
    display: none;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }
  li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 28px;
    border-radius: var(--radius-md);
    background: var(--blush);
  }
  h2 {
    font-size: 23px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .who {
    margin: 8px 0 0;
    color: var(--red);
    font-weight: 600;
  }
  .what {
    margin: 10px 0 0;
    color: var(--soft);
    font-size: 16px;
  }
  .pill {
    margin-top: auto;
    min-height: 42px;
    padding: 0 20px;
    font-size: 15px;
    transform-origin: left;
  }
  .who + .pill,
  .what + .pill {
    margin-top: 20px;
  }
</style>
