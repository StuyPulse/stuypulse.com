---
import Footer from "@components/footer/Footer.astro";
import BaseHead from "@components/BaseHead.astro";
import Header from "@components/header/Header.astro";
import { SITE_TITLE } from "@config";
export interface Props {
  title: string;
  description: string;
  image?: string;
  // Shows the announcement bar from src/data/stuysplash.yml (home page only).
  showBanner?: boolean;
  // Redesigned pages lay out their own full-width sections, starting with a red hero.
  fullBleed?: boolean;
}
const { title, image, description, showBanner = false, fullBleed = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead
      title={title + " | " + SITE_TITLE}
      image={image}
      description={description}
    />
  </head>
  <body>
    <Header showBanner={showBanner} joined={fullBleed} />
    {fullBleed ? (
      <main><slot /></main>
    ) : (
      <main class="container-sm page-content">
        <slot />
      </main>
    )}
    <Footer />
  </body>
</html>

<style>
  /* Keeps the footer at the bottom of short pages. */
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  main {
    flex: 1;
  }
  .page-content {
    max-width: 1120px;
    padding-top: clamp(40px, 6vw, 72px);
    padding-bottom: clamp(56px, 8vw, 96px);
  }
</style>
