---
import Footer from "@components/footer/Footer.astro";
import BaseHead from "@components/BaseHead.astro";
import Header from "@components/header/Header.astro";
import { SITE_TITLE } from "@config";
export interface Props {
  title: string;
  description: string;
  image?: string;
  showStuySplashBanner?: boolean;
}
const { title, image, description, showStuySplashBanner = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head style="position: sticky">
    <BaseHead
      title={title + " | " + SITE_TITLE}
      image={image}
      description={description}
    />
  </head>
  <body>
    <Header showStuySplashBanner={showStuySplashBanner} />
    <div class:list={["container-sm", "page-content", { "with-stuysplash-banner": showStuySplashBanner }]}>
      <slot />
    </div>
    <Footer />
  </body>
</html>

<style>
  .page-content {
    margin-top: 80px;
  }
  .page-content.with-stuysplash-banner {
    margin-top: 132px;
  }
  @media screen and (max-width: 575px) {
    .page-content.with-stuysplash-banner {
      margin-top: 144px;
    }
  }
</style>
