---
// A small line icon for an award: a trophy for wins, a medal for finalists, a star for
// awards given to a person, and a ribbon for everything else.
import type { AwardKind } from "@utils/awards";

export interface Props {
  kind: AwardKind;
  size?: number;
}
const { kind, size = 20 } = Astro.props;
---

<svg
  class="award-icon"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {
    kind === "win" && (
      <>
        <path d="M7 4h10v5a5 5 0 0 1-10 0V4Z" />
        <path d="M7 6H4v1a3 3 0 0 0 3 3M17 6h3v1a3 3 0 0 1-3 3M12 14v4M8 20h8" />
      </>
    )
  }
  {
    kind === "finalist" && (
      <>
        <circle cx="12" cy="15" r="5" />
        <path d="M8.5 11 6 3h4l2 5 2-5h4l-2.5 8" />
      </>
    )
  }
  {kind === "person" && <path d="m12 3 2.6 5.5 6 .8-4.4 4.1 1.1 5.9L12 16.4l-5.3 2.9 1.1-5.9-4.4-4.1 6-.8L12 3Z" />}
  {
    kind === "award" && (
      <>
        <circle cx="12" cy="9" r="6" />
        <path d="m8.5 14-1.5 7 5-2.5 5 2.5-1.5-7" />
      </>
    )
  }
</svg>

<style>
  .award-icon {
    flex: none;
  }
</style>
