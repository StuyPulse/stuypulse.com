---
export interface Props {
  pages: number;
  current: number;
}
const { pages, current } = Astro.props;
const href = (page: number) => (page === 1 ? "/news/" : `/news/${page}/`);
---

{pages > 1 && (
  <nav class="pager" aria-label="Older and newer newsletters">
    {current > 1 ? <a class="pill pill-line" href={href(current - 1)}>Newer</a> : <span />}
    <ol>
      {Array.from({ length: pages }, (_, i) => i + 1).map((page) => (
        <li>
          <a href={href(page)} aria-current={page === current ? "page" : undefined}>{page}</a>
        </li>
      ))}
    </ol>
    {current < pages ? <a class="pill pill-line" href={href(current + 1)}>Older</a> : <span />}
  </nav>
)}

<style>
  .pager {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-top: 56px;
    flex-wrap: wrap;
  }
  ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    margin: 0;
  }
  ol a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: var(--ink);
    font-weight: 700;
  }
  ol a:hover {
    background: var(--blush);
  }
  ol a[aria-current] {
    background: var(--red);
    color: #fff;
  }
</style>
