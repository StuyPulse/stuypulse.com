---
import type { CollectionEntry } from "astro:content";

export interface Props {
  entries: CollectionEntry<"news">[];
  numPosts: number;
}

const { entries, numPosts } = Astro.props;

const posts = await Promise.all(
  entries.slice(0, numPosts).map(async (entry) => ({
    entry,
    Content: (await entry.render()).Content,
    date: entry.data.date.toLocaleDateString("en-us", {
      year: "numeric",
      month: "long",
      day: "numeric",
      timeZone: "UTC",
    }),
  })),
);
---

<style>
  .post {
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line, #ddd);
  }
  .post h3 {
    margin-bottom: 0.25rem;
  }
  .post-meta {
    margin-bottom: 0.5rem;
    color: var(--muted, #666);
  }
</style>

{
  posts.map(({ entry, Content, date }) => (
    <article class="post">
      <h3>
        <a href={`/news/${entry.slug}`}>{entry.data.title}</a>
      </h3>
      <p class="post-meta">
        By {entry.data.author} on {date}
      </p>
      {entry.data.link ? (
        <a href={entry.data.link}>Read the newsletter (PDF)</a>
      ) : (
        <Content />
      )}
    </article>
  ))
}
