---
// One page of the news archive: the newest post as a red card on page 1, the rest grouped by year.
import type { CollectionEntry } from "astro:content";
import PageHead from "@components/redesign/PageHead.astro";
import Paginator from "@components/news/Paginator.astro";
import { formatDate, kindOf } from "@utils/news";

export interface Props {
  posts: CollectionEntry<"news">[];
  page: number;
  pages: number;
}
const { posts, page, pages } = Astro.props;
const [featured, ...rest] = page === 1 ? posts : [undefined, ...posts];
const years = [...new Set(rest.map((post) => post!.data.date.getUTCFullYear()))];
const label = { pdf: "PDF", canva: "Canva", post: "Post" };
---

<PageHead
  title="Newsletters"
  intro="Build updates, competition results and team news, written by our Business department."
/>

<div class="band">
  {featured && (
    <a class="featured" href={`/news/${featured.slug}`}>
      <span class="chip">Newest</span>
      <b>{featured.data.title}</b>
      <time datetime={featured.data.date.toISOString().slice(0, 10)}>{formatDate(featured.data.date)}</time>
      <span class="pill pill-white">Read it</span>
    </a>
  )}

  {years.map((year) => (
    <section class="year" aria-labelledby={`y${year}`}>
      <h2 id={`y${year}`}>{year}</h2>
      <ul>
        {rest
          .filter((post) => post!.data.date.getUTCFullYear() === year)
          .map((post) => (
            <li>
              <a href={`/news/${post!.slug}`}>
                <time datetime={post!.data.date.toISOString().slice(0, 10)}>
                  {formatDate(post!.data.date, { month: "short", day: "numeric" })}
                </time>
                <span class="title">{post!.data.title}</span>
                <span class="kind">{label[kindOf(post!)]}</span>
              </a>
            </li>
          ))}
      </ul>
    </section>
  ))}

  <Paginator pages={pages} current={page} />
</div>

<style>
  .band {
    max-width: 1120px;
  }
  .featured {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    padding: clamp(28px, 4vw, 48px);
    border-radius: var(--radius-lg);
    background: var(--blush);
    color: var(--ink);
    margin-bottom: 24px;
  }
  .featured .chip {
    background: var(--red);
    color: #fff;
  }
  .featured b {
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1;
    letter-spacing: -0.03em;
    font-variation-settings: "opsz" 96;
    text-wrap: balance;
  }
  .featured .pill {
    background: var(--red);
    color: #fff;
  }
  .featured:hover .pill {
    background: var(--red-dark);
  }
  .year {
    margin-top: 48px;
  }
  .year h2 {
    font-size: clamp(2rem, 3.6vw, 3rem);
    color: var(--red);
    margin: 0 0 12px;
  }
  .year ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .year a {
    display: grid;
    grid-template-columns: 84px 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 14px 18px;
    margin: 0 -18px;
    border-radius: 22px;
    color: var(--ink);
  }
  .year a:hover {
    background: var(--blush);
    color: var(--red);
  }
  time {
    color: var(--soft);
    font-size: 16px;
  }
  .title {
    font-weight: 700;
    font-size: 19px;
    line-height: 1.3;
  }
  .kind {
    font-size: 14px;
    font-weight: 700;
    color: var(--red);
    background: var(--blush);
    border-radius: 999px;
    padding: 3px 11px;
  }
  .year a:hover .kind {
    background: #fff;
  }
  @media (max-width: 640px) {
    .year a {
      grid-template-columns: 1fr auto;
      gap: 4px 12px;
      padding: 12px;
      margin: 0 -12px;
    }
    time {
      grid-column: 1 / -1;
    }
  }
</style>
