---
// Red hero that continues the header: big headline on the left, rounded photo with stickers on the right.
export interface Props {
  title: string;
  intro?: string;
  photo?: string;
  photoAlt?: string;
  // Up to three stickers; the second one is red.
  stickers?: string[];
}
const { title, intro, photo, photoAlt = "", stickers = [] } = Astro.props;
---

<section class="hero">
  <svg class="beat" viewBox="0 0 1440 150" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 110 H520 L560 110 L585 30 L615 150 L640 80 L660 110 H1440"></path>
  </svg>
  <div class="grid">
    <div class="copy">
      <slot name="before" />
      <h1>{title}</h1>
      {intro && <p class="intro">{intro}</p>}
      {Astro.slots.has("actions") && <div class="actions"><slot name="actions" /></div>}
      <slot name="after" />
    </div>
    {photo ? (
      <div class="photo">
        <div class="frame"><img src={photo} alt={photoAlt} /></div>
        {stickers.map((text, i) => <span class:list={["sticker", `s${i + 1}`]}>{text}</span>)}
      </div>
    ) : (
      <slot name="side" />
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--red);
    color: #fff;
    padding-bottom: 88px;
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  }
  .beat {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 150px;
    pointer-events: none;
  }
  .beat path {
    fill: none;
    stroke: rgba(255, 255, 255, 0.3);
    stroke-width: 3;
    stroke-linejoin: round;
    stroke-linecap: round;
    stroke-dasharray: 3200;
    stroke-dashoffset: 3200;
    animation: draw 2.4s 0.2s cubic-bezier(0.6, 0, 0.2, 1) forwards;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .beat path {
      stroke-dashoffset: 0;
    }
  }
  .grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
    padding: 24px var(--gutter) 0;
  }
  h1 {
    font-size: clamp(3.2rem, 7.2vw, 6.8rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
    margin: 0;
  }
  .intro {
    font-size: clamp(18px, 1.7vw, 22px);
    margin: 24px 0 0;
    max-width: 32ch;
  }
  .photo {
    position: relative;
  }
  .frame {
    border-radius: 36px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    box-shadow: 0 30px 60px -24px rgba(70, 0, 4, 0.55);
  }
  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .sticker {
    position: absolute;
    background: #fff;
    color: var(--red);
    font-weight: 800;
    font-size: clamp(16px, 1.7vw, 22px);
    padding: 12px 22px;
    border-radius: 999px;
    box-shadow: 0 14px 28px -12px rgba(50, 0, 0, 0.5);
    white-space: nowrap;
    letter-spacing: -0.01em;
  }
  .s1 {
    right: -14px;
    top: -22px;
    transform: rotate(6deg);
  }
  .s2 {
    left: -26px;
    bottom: 54px;
    transform: rotate(-6deg);
    background: var(--red);
    color: #fff;
    box-shadow: 0 14px 28px -12px rgba(50, 0, 0, 0.5), inset 0 0 0 3px #fff;
  }
  .s3 {
    right: 40px;
    bottom: -22px;
    transform: rotate(3deg);
  }
  @media (max-width: 860px) {
    .hero {
      padding-bottom: 56px;
    }
    .grid {
      grid-template-columns: 1fr;
    }
    .s1 {
      right: 8px;
    }
    .s2 {
      left: 8px;
    }
  }
</style>
