---
// Every season as one heartbeat: a spike per robot, as tall as the awards it won. On phones the
// chart is wider than the screen and scrolls sideways, following the line as it draws.
import { plural } from "@utils/format";
import { getRobots } from "@utils/robots";

export interface Props {
  // Years whose robot photo sits on its peak.
  photoYears?: number[];
}
const { photoYears = [] } = Astro.props;

const robots = await getRobots();
const latestYear = robots[robots.length - 1].data.year;
const W = 1000,
  H = 300,
  base = 260,
  s = W / robots.length;
// The flat line runs past both ends so it reaches the content edges; the chart clips it there.
let d = `M-200 ${base} L0 ${base}`;
const spikes = robots.map((robot, i) => {
  const awards = robot.data.awards?.length ?? 0;
  const x = i * s + s / 2,
    y = base - awards * 20;
  d += ` L${x - s * 0.3} ${base} L${x - s * 0.12} ${base + 12} L${x} ${y} L${x + s * 0.14} ${base + 18} L${x + s * 0.3} ${base}`;
  return {
    name: robot.data.title,
    year: robot.data.year,
    slug: robot.slug,
    awards,
    photo: photoYears.includes(robot.data.year) ? robot.data.photo : undefined,
    left: (x / W) * 100,
    top: (y / H) * 100,
  };
});
d += ` L${W + 200} ${base}`;
---

<div class="strip" data-strip>
  <div class="chart" data-heartbeat>
    <div class="plot">
      <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true"><path d={d}></path></svg>
      {
        spikes.map((spike) => (
          <a
            class:list={["spike", { pic: spike.photo, big: spike.year === latestYear }]}
            style={`left:${spike.left}%;top:${spike.top}%`}
            href={`/about/history/${spike.slug}`}
            aria-label={`${spike.name}, ${spike.year}, ${plural(spike.awards, "award")}`}
            data-tip={`<b>${spike.name}</b> ${spike.year}, ${plural(spike.awards, "award")}`}
          >
            {spike.photo && <img src={spike.photo} alt="" loading="lazy" />}
          </a>
        ))
      }
    </div>
    <div class="tip" aria-hidden="true"></div>
  </div>
</div>
<div class="years">
  <span>{robots[0].data.year}, {robots[0].data.title}</span>
  <span>{latestYear}, {robots[robots.length - 1].data.title}</span>
</div>

<script>
  const SWEEP = 1600;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>("[data-heartbeat]").forEach((chart) => {
    const strip = chart.closest<HTMLElement>("[data-strip]")!;
    const tip = chart.querySelector<HTMLElement>(".tip")!;
    const spikes = chart.querySelectorAll<HTMLElement>(".spike");

    // The tooltip sits above its spike (below it if there's no room) and is clamped to the chart.
    spikes.forEach((spike) => {
      const show = () => {
        tip.innerHTML = spike.dataset.tip ?? "";
        const box = chart.getBoundingClientRect();
        const dot = spike.getBoundingClientRect();
        const x = dot.left + dot.width / 2 - box.left;
        const left = Math.min(Math.max(x - tip.offsetWidth / 2, 0), box.width - tip.offsetWidth);
        const above = dot.top - box.top - tip.offsetHeight - 12;
        tip.style.left = `${left}px`;
        tip.style.top = `${above >= 0 ? above : dot.bottom - box.top + 12}px`;
        tip.classList.add("show");
      };
      const hide = () => tip.classList.remove("show");
      spike.addEventListener("mouseenter", show);
      spike.addEventListener("focus", show);
      spike.addEventListener("mouseleave", hide);
      spike.addEventListener("blur", hide);
    });

    // Draw the line left to right the first time the chart scrolls into view, popping each
    // marker in as the sweep reaches it. Without JS or with reduced motion it is just drawn.
    if (reduce || !("IntersectionObserver" in window)) return;
    chart.classList.add("armed");
    // On phones the strip scrolls from 2001 to today in step with the line. Touching it hands
    // control straight back.
    const follow = () => {
      const max = strip.scrollWidth - strip.clientWidth;
      if (max <= 0) return;
      let stopped = false;
      const stop = () => (stopped = true);
      ["pointerdown", "wheel", "touchstart", "keydown"].forEach((type) =>
        strip.addEventListener(type, stop, { once: true, passive: true }),
      );
      strip.style.scrollSnapType = "none";
      const start = performance.now();
      const tick = (now: number) => {
        const t = Math.min((now - start) / SWEEP, 1);
        if (stopped) {
          strip.style.scrollSnapType = "";
          return;
        }
        // Keeps the drawing edge a third of the way in until the end comes into view.
        strip.scrollLeft = Math.min(Math.max(t * strip.scrollWidth - strip.clientWidth / 3, 0), max);
        if (t < 1) requestAnimationFrame(tick);
        else strip.style.scrollSnapType = "";
      };
      requestAnimationFrame(tick);
    };

    // The strip is observed, not the chart: on phones the chart is mostly scrolled out of view.
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        observer.disconnect();
        const box = chart.getBoundingClientRect();
        spikes.forEach((spike) => {
          const dot = spike.getBoundingClientRect();
          const at = (dot.left + dot.width / 2 - box.left) / box.width;
          spike.style.animationDelay = `${Math.max(at * SWEEP - 120, 0)}ms`;
        });
        chart.classList.add("play");
        follow();
        setTimeout(() => chart.classList.remove("armed", "play"), SWEEP + 800);
      },
      { threshold: 0.35 },
    );
    observer.observe(strip);
  });
</script>

<style>
  .chart {
    /* Keeps the end markers (and their rings) inside the content edges. */
    --pad: 48px;
    position: relative;
    height: 340px;
    margin-top: 48px;
    overflow-x: clip;
  }
  .plot {
    position: absolute;
    inset: 0 var(--pad);
  }
  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  path {
    fill: none;
    stroke: var(--red);
    stroke-width: 3;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .spike {
    position: absolute;
    width: 30px;
    height: 30px;
    margin: -15px 0 0 -15px;
    border-radius: 50%;
  }
  .spike::after {
    content: "";
    position: absolute;
    inset: 9px;
    border-radius: 50%;
    background: var(--red);
    box-shadow: 0 0 0 4px #fff;
    transition: transform 0.15s ease;
  }
  .spike:hover::after,
  .spike:focus-visible::after {
    transform: scale(1.5);
  }
  .spike.pic {
    width: 64px;
    height: 64px;
    margin: -32px 0 0 -32px;
    overflow: hidden;
    box-shadow:
      0 0 0 4px var(--red),
      0 0 0 8px #fff;
    transition: transform 0.15s ease;
  }
  .spike.pic:hover {
    transform: scale(1.08);
  }
  .spike.pic::after {
    display: none;
  }
  .spike.big {
    width: 104px;
    height: 104px;
    margin: -52px 0 0 -52px;
  }
  .spike img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tip {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 5;
    background: var(--ink);
    color: #fff;
    border-radius: 18px;
    padding: 10px 16px;
    font-size: 15px;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.12s ease;
  }
  .tip.show {
    opacity: 1;
  }

  /* Draw-on: the line is uncovered left to right like a heart monitor's sweep. */
  .armed:not(.play) svg {
    clip-path: inset(-20px calc(100% + var(--pad)) -20px calc(-1 * var(--pad)));
  }
  .armed:not(.play) .spike {
    opacity: 0;
  }
  .play svg {
    animation: sweep 1.6s linear backwards;
  }
  .play .spike {
    animation: pop 0.45s ease-out backwards;
  }
  @keyframes sweep {
    from {
      clip-path: inset(-20px calc(100% + var(--pad)) -20px calc(-1 * var(--pad)));
    }
    to {
      clip-path: inset(-20px calc(-1 * var(--pad)) -20px calc(-1 * var(--pad)));
    }
  }
  @keyframes pop {
    0% {
      opacity: 0;
      transform: scale(0.6);
    }
    60% {
      opacity: 1;
      transform: scale(1.08);
    }
    100% {
      transform: scale(1);
    }
  }

  .years {
    display: flex;
    justify-content: space-between;
    font-weight: 700;
    color: var(--soft);
    font-size: 16px;
    margin-top: 8px;
  }
  /* Phones: a rounded strip you swipe through, wide enough that every spike gets its own tap target. */
  @media (max-width: 860px) {
    .strip {
      margin: 28px 0 0;
      border-radius: var(--radius-md);
      background: var(--blush);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
      padding-top: 18px;
    }
    .strip::-webkit-scrollbar {
      display: none;
    }
    .chart {
      --pad: 40px;
      width: 1100px;
      height: 270px;
      margin-top: 0;
    }
    .spike::after {
      box-shadow: 0 0 0 4px var(--blush);
    }
    .spike.pic {
      scroll-snap-align: center;
      width: 50px;
      height: 50px;
      margin: -25px 0 0 -25px;
      box-shadow:
        0 0 0 3px var(--red),
        0 0 0 6px #fff;
    }
    .spike.big {
      width: 76px;
      height: 76px;
      margin: -38px 0 0 -38px;
    }
  }
</style>
