---
// One big number for the right half of a red page head: a white disc with the number in red,
// what it counts underneath, and an optional tilted sticker. Numbers come from the data.
export interface Props {
  value: number | string;
  label: string;
  sticker?: string;
  href?: string;
}
const { value, label, sticker, href } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag class="stat" href={href}>
  <span class="disc">
    <b>{value}</b>
    <span class="label">{label}</span>
  </span>
  {sticker && <span class="sticker">{sticker}</span>}
</Tag>

<style>
  .stat {
    position: relative;
    display: block;
    width: min(100%, 400px);
    margin-inline: auto;
    color: var(--ink);
  }
  .disc {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    padding: 14%;
    border-radius: 50%;
    background: #fff;
    text-align: center;
    box-shadow: 0 30px 60px -30px rgba(60, 0, 4, 0.6);
    container-type: inline-size;
  }
  b {
    color: var(--red);
    font-size: clamp(64px, 40cqi, 160px);
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-variation-settings: "opsz" 96;
  }
  .label {
    margin-top: 10px;
    color: var(--ink);
    font-size: clamp(16px, 7cqi, 21px);
    font-weight: 700;
    line-height: 1.25;
    text-wrap: balance;
  }
  a.stat .disc {
    transition: transform 0.2s ease;
  }
  a.stat:hover .disc {
    transform: rotate(-3deg) scale(1.02);
  }
  .sticker {
    position: absolute;
    top: 6%;
    right: -2%;
    padding: 12px 22px;
    border-radius: 999px;
    background: var(--red);
    color: #fff;
    font-weight: 800;
    font-size: clamp(16px, 1.7vw, 21px);
    white-space: nowrap;
    box-shadow:
      0 14px 28px -12px rgba(50, 0, 0, 0.5),
      inset 0 0 0 3px #fff;
    transform: rotate(7deg);
  }
  @media (max-width: 860px) {
    .stat {
      width: min(100%, 260px);
      margin-top: 8px;
    }
    .sticker {
      right: -6%;
    }
  }
</style>
