---
// A row of dates along a red line that draws itself across when it scrolls into view.
// On phones the row turns into a column and the line runs down the side.
export interface Props {
  items: { year: number | string; text: string; href?: string }[];
}
const { items } = Astro.props;
---

<div class="milestones">
  <span class="line" aria-hidden="true"></span>
  <ol>
    {
      items.map((item, i) => (
        <li style={`--i:${i}`}>
          <span class="dot" aria-hidden="true" />
          <b>{item.year}</b>
          {item.href ? <a href={item.href}>{item.text}</a> : <span>{item.text}</span>}
        </li>
      ))
    }
  </ol>
</div>

<script>
  // The start state (line undrawn, dots hidden) is only set here, so without JS or with
  // reduced motion everything simply shows.
  const rows = document.querySelectorAll<HTMLElement>(".milestones");
  if (rows.length && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("drawn");
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.35 },
    );
    for (const row of rows) {
      row.classList.add("armed");
      observer.observe(row);
    }
  }
</script>

<style>
  .milestones {
    position: relative;
    margin-top: 40px;
  }
  /* The line runs through the middle of the dots. */
  .line {
    position: absolute;
    left: 0;
    right: 0;
    top: 15px;
    height: 6px;
    border-radius: 999px;
    background: var(--red);
    transform-origin: left center;
  }
  ol {
    position: relative;
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    gap: 16px;
  }
  li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .dot {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #fff;
    box-shadow: inset 0 0 0 8px var(--red);
  }
  li:last-child .dot {
    background: var(--red);
    box-shadow:
      inset 0 0 0 8px var(--red),
      0 0 0 6px var(--rose);
  }
  b {
    margin-top: 16px;
    color: var(--red);
    font-size: clamp(34px, 3.4vw, 48px);
    line-height: 1;
    letter-spacing: -0.04em;
    font-variation-settings: "opsz" 96;
  }
  li > span:last-child,
  li > a {
    margin-top: 8px;
    font-weight: 600;
    font-size: 16px;
    line-height: 1.35;
    color: var(--ink);
  }
  li > a {
    text-decoration: underline;
    text-decoration-color: var(--rose);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  li > a:hover {
    color: var(--red);
  }

  .armed .line {
    transform: scaleX(0);
    transition: transform 1.4s cubic-bezier(0.6, 0, 0.2, 1);
  }
  .armed li {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.4s ease,
      transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    transition-delay: calc(0.15s + var(--i) * 0.16s);
  }
  .armed.drawn .line {
    transform: none;
  }
  .armed.drawn li {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 860px) {
    .line {
      top: 0;
      bottom: 0;
      left: 15px;
      right: auto;
      width: 6px;
      height: auto;
      transform-origin: center top;
    }
    .armed .line {
      transform: scaleY(0);
    }
    ol {
      grid-auto-flow: row;
      gap: 28px;
    }
    li {
      display: grid;
      grid-template-columns: 36px 1fr;
      column-gap: 18px;
      align-items: center;
    }
    b {
      margin: 0;
      font-size: 32px;
    }
    li > span:last-child,
    li > a {
      grid-column: 2;
      margin-top: 4px;
    }
  }
</style>
