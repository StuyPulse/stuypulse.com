---
import type { LeadershipType } from "@types";

export interface Props {
  leadership: LeadershipType;
  height: string;
  width: string;
  tSize: string;
  hSize: string;
}

const { leadership, height, width, tSize, hSize } = Astro.props;
const initials = leadership.name.split(/\s+/).map((part) => part[0]).join("");
---

<style define:vars={{ height, width, tSize, hSize }}>
  .card {
    box-shadow: 0 2px 4px 0 rgba(0, 0, 0, 0.2), 0 3px 10px 0 rgba(0, 0, 0, 0.19);
  }
  .leadership-container {
    height: var(--height);
    width: var(--width);
  }
  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .card-header h3 {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .card-header a {
    flex-shrink: 0;
  }
  .portrait-placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    width: 100%;
    background: #f2f2f2;
    border: 1px solid #e5e5e5;
    border-radius: 4px;
    color: #6c757d;
    font-size: 2.5rem;
    font-weight: 700;
  }

  .card-body {
    padding: 0.2em !important;
    padding-right: 0.5em !important;
  }

  p {
    font-size: var(--tSize);
    text-indent: 1.5rem;
    text-align: justify;
  }
  h3 {
    font-size: var(--hSize);
    margin: 5px;
    color: black;
  }
</style>

<div class="leadership-container">
  <div class="card">
    <div class="card-header">
          <h3 class="m-0">{leadership.name}</h3>
          <a href={"/../about/departments#" + leadership.department}>
            {
              [
                "Software Engineering",
                "Mechanical Engineering",
                "Business",
                "Strategy",
              ].includes(leadership.department) ? (
                <img
                  src={
                    "/icons/" +
                    leadership.department.split(" ")[0].toLowerCase() +
                    ".svg"
                  }
                  alt={leadership.department}
                  width="32px"
                />
              ) : (
                <p class="text-white">{leadership.department}</p>
              )
            }
          </a>
    </div>
    <div class="card-body">
      <div class="row no-gutters">
        <div
          class="col-10 col-md-4"
          style="max-width:250px; padding:25px; margin: auto;"
        >
          {leadership.image ? (
            <img src={leadership.image} alt={leadership.name} />
          ) : (
            <div class="portrait-placeholder" aria-hidden="true">{initials}</div>
          )}
        </div>
        <div class="col-md-8">
          <div class="card-body">
            <h3 class="card-text m-0 mb-2 mt-2">{leadership.position}</h3>
            <p class="card-text" style="text-indent: 0;">{leadership.description}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
