---
import type { NavType } from "@types";
import Nav from "./Nav.astro";

export interface Props {
  nav: NavType;
}

const { nav } = Astro.props;
---

<li class="nav-item dropdown">
  <a
    class="nav-link dropdown-toggle"
    href="#"
    role="button"
    data-bs-toggle="dropdown"
    aria-expanded="false"
  >
    {nav.name}
  </a>
  <ul class="dropdown-menu">
    {nav.dropdown && nav.dropdown.map((_nav) => <Nav nav={_nav} inMenu />)}
  </ul>
</li>

<style>
  .nav-link {
    padding: 10px 14px !important;
    border-radius: 999px;
    color: #fff;
    font-weight: 500;
    font-size: 17px;
  }
  .nav-link:hover,
  .nav-link:focus-visible,
  .nav-link.show {
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
  }
  .dropdown-menu {
    margin-top: 8px !important;
    padding: 8px;
    border: 0;
    border-radius: 24px;
    box-shadow: 0 20px 40px -16px rgba(60, 0, 4, 0.45);
  }
  @media (max-width: 991px) {
    .nav-link {
      color: var(--ink);
      border-radius: 16px;
    }
    .nav-link:hover,
    .nav-link:focus-visible,
    .nav-link.show {
      background: var(--blush);
      color: var(--red);
    }
    .dropdown-menu {
      margin: 0 0 6px 12px !important;
      padding: 0;
      box-shadow: none;
    }
  }
</style>
