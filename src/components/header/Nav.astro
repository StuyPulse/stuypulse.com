---
import type { NavType } from "@types";

export interface Props {
  nav: NavType;
  inMenu?: boolean;
}

const { nav, inMenu = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "");
const current = !!nav.href && path === nav.href.replace(/\/$/, "");
---

<li class="nav-item">
  <a
    class:list={[inMenu ? "dropdown-item" : "nav-link"]}
    aria-current={current ? "page" : undefined}
    href={nav.href}
  >
    {nav.name}
  </a>
</li>

<style>
  .nav-link {
    padding: 10px 14px !important;
    border-radius: 999px;
    color: #fff;
    font-weight: 500;
    font-size: 17px;
  }
  .nav-link:hover,
  .nav-link:focus-visible {
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
  }
  .nav-link[aria-current] {
    background: rgba(255, 255, 255, 0.2);
  }
  .dropdown-item {
    padding: 10px 16px;
    border-radius: 16px;
    color: var(--ink);
    font-weight: 500;
  }
  .dropdown-item:hover,
  .dropdown-item:focus-visible,
  .dropdown-item[aria-current] {
    background: var(--blush);
    color: var(--red);
  }
  @media (max-width: 991px) {
    .nav-link {
      color: var(--ink);
      border-radius: 16px;
    }
    .nav-link:hover,
    .nav-link:focus-visible,
    .nav-link[aria-current] {
      background: var(--blush);
      color: var(--red);
    }
  }
</style>
