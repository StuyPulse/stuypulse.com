---
import type { NavType } from '@types.js';
import Nav from './Nav.astro';
import Dropdown from './Dropdown.astro';
const navs = (await import('@data/navbar.yml')).default;
export interface Props {
  showStuySplashBanner?: boolean;
}
const { showStuySplashBanner = false } = Astro.props;
---

{showStuySplashBanner && (
  <div class="stuysplash-banner">
    <div class="stuysplash-banner-copy">
      <strong>StuySplash 2026</strong>
      <span>December 12</span>
    </div>
    <a href="/#stuysplash">Learn more about StuySplash <span aria-hidden="true">→</span></a>
  </div>
)}
<nav class:list={["navbar", "navbar-expand-lg", "fixed-top", "mb-3", { "with-stuysplash-banner": showStuySplashBanner }]}>
  <div class="container-fluid">
    <a class="navbar-brand text-white" href="/">
      <img src="/icons/694_white.svg" width="32px" height="32px" />
      StuyPulse
    </a>

    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavDropdown"
      aria-controls="navbarNavDropdown"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div
      class="collapse navbar-collapse flex-row-reverse"
      id="navbarNavDropdown"
    >
      <div style="height:10px"></div>
      <ul class="navbar-nav">
        {
          navs.map((nav: NavType) =>
            nav.dropdown ? <Dropdown nav={nav} /> : <Nav nav={nav} />
          )
        }
      </ul>
      <style>
        /* .navbar-nav:last-child {
          // bg color light blue
          background: rgb(246, 251, 255);
        } */
      </style>
    </div>
  </div>
</nav>

<style>
  .stuysplash-banner {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1040;
    display: flex;
    width: 100%;
    height: 52px;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 0 1.25rem;
    background-color: #fff;
    border-bottom: 1px solid #e5e5e5;
    color: #333;
  }
  .stuysplash-banner-copy {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .stuysplash-banner-copy strong {
    font-weight: 700;
    color: #333;
  }
  .stuysplash-banner a {
    flex-shrink: 0;
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    background-color: red;
    color: white;
    font-weight: 700;
  }
  .stuysplash-banner a:hover,
  .stuysplash-banner a:focus-visible {
    background-color: #e00;
    color: white;
  }
  .stuysplash-banner a:focus-visible {
    outline: 3px solid #e00;
    outline-offset: 2px;
  }
  .with-stuysplash-banner {
    top: 52px;
  }
  @media screen and (max-width: 575px) {
    .stuysplash-banner {
      height: 64px;
      padding: 0 0.75rem;
      gap: 0.75rem;
    }
    .stuysplash-banner-copy {
      flex-direction: column;
      gap: 0;
      font-size: 0.9rem;
      line-height: 1.25;
    }
    .stuysplash-banner-copy span {
      font-size: 0.8rem;
    }
    .stuysplash-banner a {
      padding: 0.45rem 0.75rem;
      font-size: 0.85rem;
    }
    .with-stuysplash-banner {
      top: 64px;
    }
  }
  .navbar {
    box-shadow:
      0 4px 8px 0 rgba(0, 0, 0, 0.2),
      0 6px 20px 0 rgba(0, 0, 0, 0.19);
    background: linear-gradient(
      180deg,
      rgba(224, 0, 0, 1) 59px,
      rgb(246, 251, 255) 0px
    );
  }

  @media screen and (min-width: 992px) {
    .navbar {
      box-shadow:
        0 4px 8px 0 rgba(0, 0, 0, 0.2),
        0 6px 20px 0 rgba(0, 0, 0, 0.19);
      background: linear-gradient(
        300deg,
        rgb(246, 251, 255, 1) 43em,
        rgb(138, 142, 145) 43.5em,
        rgba(224, 0, 0, 1) 10em
      );
    }
  }
</style>
