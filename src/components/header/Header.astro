---
import type { NavType } from '@types.js';
import Nav from './Nav.astro';
import Dropdown from './Dropdown.astro';
const navs = (await import('@data/navbar.yml')).default;
const splash = (await import('@data/stuysplash.yml')).default;
export interface Props {
  showBanner?: boolean;
  // The page starts with its own red hero, so the header runs straight into it.
  joined?: boolean;
}
const { showBanner = false, joined = false } = Astro.props;
const donate = navs.find((nav: NavType) => nav.href === '/donate');
const links = navs.filter((nav: NavType) => nav !== donate);
---

{showBanner && splash.showBanner && (
  <div class="stuysplash-banner">
    <strong>StuySplash {splash.year}</strong>
    <span>{splash.date}</span>
    <a href="/resources/stuysplash">Sign up</a>
  </div>
)}
<header class:list={["site-header", { joined }]}>
  <nav class="navbar navbar-expand-lg" aria-label="Main">
    <a class="brand" href="/">
      <img src="/icons/694_white.svg" width="38" height="38" alt="" />
      StuyPulse
    </a>

    <button
      class="menu-button navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavDropdown"
      aria-controls="navbarNavDropdown"
      aria-expanded="false"
    >
      Menu
    </button>

    <div class="collapse navbar-collapse" id="navbarNavDropdown">
      <ul class="navbar-nav">
        {links.map((nav: NavType) => (nav.dropdown ? <Dropdown nav={nav} /> : <Nav nav={nav} />))}
      </ul>
      {donate && <a class="pill pill-white donate" href={donate.href}>Donate</a>}
    </div>
  </nav>
</header>

<style>
  .stuysplash-banner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
    padding: 10px var(--gutter);
    background: var(--red-dark);
    color: #fff;
    font-size: 16px;
  }
  .stuysplash-banner span {
    opacity: 0.9;
  }
  .stuysplash-banner a {
    color: #fff;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .site-header {
    position: relative;
    z-index: 20;
    background: var(--red);
    color: #fff;
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  }
  .site-header.joined {
    border-radius: 0;
  }
  .navbar {
    padding: 22px var(--gutter);
    gap: 16px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #fff;
    font-weight: 800;
    font-size: 24px;
    letter-spacing: -0.02em;
  }
  .brand:hover {
    color: #fff;
  }
  .menu-button {
    height: 48px;
    padding: 0 20px;
    border: 0;
    border-radius: 999px;
    background: #fff;
    color: var(--red);
    font-family: var(--font);
    font-weight: 700;
    font-size: 16px;
  }
  .menu-button:focus {
    box-shadow: none;
  }
  .navbar-collapse {
    justify-content: flex-end;
    gap: 22px;
  }
  .navbar-nav {
    gap: 6px;
    align-items: center;
  }
  .donate {
    min-height: 48px;
  }
  @media (max-width: 991px) {
    .navbar-collapse {
      margin-top: 12px;
      padding: 16px;
      border-radius: var(--radius-md);
      background: #fff;
    }
    .navbar-nav {
      align-items: stretch;
      gap: 2px;
    }
    .donate {
      margin-top: 12px;
      width: 100%;
      background: var(--red);
      color: #fff;
    }
  }
</style>
