---
// Serves both single newsletters (/news/2026-02-28-week-0-newsletter) and the numbered
// archive pages (/news/2). Page 1 is also at /news/; its number is kept for old links.
// The numbered pages list newsletters only; written stories live at /news/stories/.
import PageSite from "@layouts/PageSite.astro";
import NewsList from "@components/news/NewsList.astro";
import NewsPost from "@components/news/NewsPost.astro";
import { formatDate } from "@utils/format";
import { POSTS_PER_LIST_PAGE, getNewsletters, kindOf, type Newsletter } from "@utils/news";

type Props =
  | { kind: "post"; entry: Newsletter; newer?: Newsletter; older?: Newsletter }
  | { kind: "list"; page: number; pages: number; posts: Newsletter[] }
  | { kind: "moved" };

export async function getStaticPaths() {
  const all = await getNewsletters();
  const newsletters = all.filter((post) => kindOf(post) !== "post");
  const stories = all.filter((post) => kindOf(post) === "post");
  const pages = Math.ceil(newsletters.length / POSTS_PER_LIST_PAGE);
  // The old site listed everything 10 to a page (up to /news/16), and those URLs are in search
  // engines; numbers past the newsletter pages send people to the stories.
  const oldPages = Math.max(Math.ceil(all.length / 10), Math.ceil(all.length / POSTS_PER_LIST_PAGE));
  // Newer and older stay within the same kind, so a newsletter leads to the next newsletter.
  const posts = (group: Newsletter[]) =>
    group.map((entry, i) => ({
      params: { slug: entry.slug },
      props: { kind: "post", entry, newer: group[i - 1], older: group[i + 1] } satisfies Props,
    }));
  return [
    ...posts(newsletters),
    ...posts(stories),
    ...Array.from({ length: pages }, (_, i) => ({
      params: { slug: String(i + 1) },
      props: {
        kind: "list",
        page: i + 1,
        pages,
        posts: newsletters.slice(i * POSTS_PER_LIST_PAGE, (i + 1) * POSTS_PER_LIST_PAGE),
      } satisfies Props,
    })),
    ...Array.from({ length: Math.max(0, oldPages - pages) }, (_, i) => ({
      params: { slug: String(pages + i + 1) },
      props: { kind: "moved" } satisfies Props,
    })),
  ];
}

const props = Astro.props;
if (props.kind === "moved") return Astro.redirect("/news/stories/");
const Content = props.kind === "post" ? (await props.entry.render()).Content : null;
---

{
  props.kind === "post" ? (
    <PageSite
      title={props.entry.data.title}
      description={`${props.entry.data.title}, from StuyPulse on ${formatDate(props.entry.data.date)}.`}
    >
      <NewsPost entry={props.entry} newer={props.newer} older={props.older}>
        {Content && <Content />}
      </NewsPost>
    </PageSite>
  ) : props.kind === "list" ? (
    <PageSite
      title={`Newsletters, page ${props.page}`}
      description="Newsletters, build updates and team news from StuyPulse, FRC Team 694."
    >
      <NewsList posts={props.posts} page={props.page} pages={props.pages} />
    </PageSite>
  ) : null
}
