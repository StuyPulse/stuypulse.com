---
import PageSite from "@layouts/PageSite.astro";
import NewsList from "@components/news/NewsList.astro";
import { POSTS_PER_LIST_PAGE, getNewsletters, kindOf } from "@utils/news";

// Written stories have their own page (/news/stories/); this archive is the newsletters.
const posts = (await getNewsletters()).filter((post) => kindOf(post) !== "post");
---

<PageSite title="Newsletters" description="Newsletters, build updates and team news from StuyPulse, FRC Team 694.">
  <NewsList
    posts={posts.slice(0, POSTS_PER_LIST_PAGE)}
    page={1}
    pages={Math.ceil(posts.length / POSTS_PER_LIST_PAGE)}
  />
</PageSite>
