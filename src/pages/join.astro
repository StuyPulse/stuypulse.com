---
import PageSite from "@layouts/PageSite.astro";
import Hero from "@components/redesign/Hero.astro";

// Short versions of /about/departments.
const departments = [
  {
    id: "mechanical",
    name: "Mechanical",
    icon: "/icons/mechanical.svg",
    text: "Design and build the robot in small groups of 4 to 6, each with a veteran member, focused on one part: the drive train, electronics or a mechanism.",
    tags: ["Design", "Machining", "Electronics"],
  },
  {
    id: "software",
    name: "Software",
    icon: "/icons/software.svg",
    text: "Write the code that drives the robot on the field. We teach everyone Java from the start, and all our code is open source.",
    tags: ["Java", "Robot code", "Open source"],
  },
  {
    id: "business",
    name: "Business",
    icon: "/icons/business.svg",
    text: "Fundraising, sponsors, branding, outreach, award submissions and travel planning: everything that keeps the team running.",
    tags: ["Sponsors", "Outreach", "Branding"],
  },
  {
    id: "strategy",
    name: "Strategy",
    icon: "/icons/strategy.svg",
    text: "Help decide how the robot should be designed, how it plays each match, and which teams we pick as alliance partners.",
    tags: ["Game strategy", "Alliance selection"],
  },
];
---

<PageSite
  title="Join"
  description="StuyPulse has no cuts and no tryouts. Any Stuyvesant student can join FIRST Robotics Team 694."
  fullBleed
>
  <Hero
    title="No cuts. No tryouts."
    intro="If you go to Stuyvesant, you can join. You don't need to know anything about robots yet. We'll teach you."
    photo="/team/HVR.jpg"
    photoAlt="StuyPulse at the Hudson Valley Regional"
    stickers={["Every grade", "No experience needed"]}
  >
    <Fragment slot="actions">
      <a class="pill pill-white" href="#year">How the year goes</a>
      <a class="pill pill-ghost" href="#departments">Pick a department</a>
    </Fragment>
  </Hero>

  <section class="section" id="departments" aria-labelledby="d-title">
    <h2 id="d-title">Four ways in</h2>
    <p class="lede">You join one department, but nobody stops you from learning the others.</p>
    <div class="deptgrid">
      {departments.map((dept, i) => (
        <article class:list={["card", { "card-red": i === 0 }]} id={dept.id}>
          <div class="ic"><img src={dept.icon} alt="" /></div>
          <h3>{dept.name}</h3>
          <p>{dept.text}</p>
          <ul>{dept.tags.map((tag) => <li>{tag}</li>)}</ul>
        </article>
      ))}
    </div>
    <p class="more"><a href="/about/departments">Read more about each department</a> or <a href="/about/leadership">meet the leadership</a>.</p>
  </section>

  <section class="year section" id="year" aria-labelledby="y-title">
    <h2 id="y-title">How your first year goes</h2>
    <ol class="steps">
      <li><b>Fall training</b><p>Come to the interest meeting and learn the basics in your department.</p></li>
      <li><b>Kickoff</b><p>In January, FIRST reveals the new game and we start from a blank page.</p></li>
      <li><b>Build season</b><p>Design, build and code the robot between kickoff and our first competition.</p></li>
      <li><b>Competitions</b><p>Take the robot to regional competitions in the spring.</p></li>
    </ol>
  </section>

  <section class="section" aria-labelledby="q-title">
    <h2 id="q-title">Questions people ask</h2>
    <div class="faq">
      <details open><summary>Do I need any experience?</summary><p>No. Training starts from the basics in every department.</p></details>
      <details><summary>Which grades can join?</summary><p>Any Stuyvesant student.</p></details>
      <details><summary>Who do I ask about joining?</summary><p>Email <a href="mailto:info@stuypulse.com">info@stuypulse.com</a>, or find us at the interest meeting in the fall.</p></details>
    </div>
  </section>
</PageSite>

<style>
  .section {
    padding: clamp(72px, 9vw, 120px) var(--gutter);
  }
  h2 {
    font-size: clamp(2.3rem, 4.4vw, 4rem);
    margin: 0;
  }
  .deptgrid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 44px;
  }
  .card {
    border-radius: var(--radius-lg);
    background: var(--blush);
    padding: clamp(28px, 3.4vw, 44px);
    scroll-margin-top: 24px;
  }
  .card h3 {
    font-size: clamp(1.6rem, 2.4vw, 2.1rem);
    margin: 0;
  }
  .ic {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: #fff;
    box-shadow: inset 0 0 0 2px var(--rose);
    display: grid;
    place-items: center;
    margin-bottom: 22px;
  }
  .ic img {
    width: 38px;
  }
  .card p {
    color: var(--soft);
    margin: 12px 0 0;
    max-width: 46ch;
  }
  .card ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 20px 0 0;
  }
  .card li {
    background: #fff;
    color: var(--red);
    border-radius: 999px;
    padding: 6px 14px;
    font-weight: 600;
    font-size: 15px;
  }
  .card-red {
    background: var(--red);
    color: #fff;
  }
  .card-red p {
    color: #fff;
    opacity: 0.92;
  }
  .card-red .ic {
    box-shadow: none;
  }
  .more {
    margin-top: 28px;
    font-size: 18px;
  }
  .more a {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .year {
    margin: 0 20px;
    border-radius: var(--radius-lg);
    background: var(--red);
    color: #fff;
  }
  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin: 48px 0 0;
    counter-reset: step;
  }
  .steps li {
    position: relative;
    padding-top: 74px;
  }
  .steps li::before {
    counter-increment: step;
    content: counter(step);
    position: absolute;
    top: 0;
    left: 0;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: #fff;
    color: var(--red);
    display: grid;
    place-items: center;
    font-weight: 800;
    font-size: 24px;
  }
  .steps li::after {
    content: "";
    position: absolute;
    top: 26px;
    left: 66px;
    right: -8px;
    height: 2px;
    background: rgba(255, 255, 255, 0.4);
  }
  .steps li:last-child::after {
    display: none;
  }
  .steps b {
    font-size: 23px;
    display: block;
    letter-spacing: -0.02em;
  }
  .steps p {
    margin: 8px 0 0;
    opacity: 0.92;
  }

  .faq {
    display: grid;
    gap: 12px;
    margin-top: 40px;
    max-width: 900px;
  }
  details {
    background: var(--blush);
    border-radius: 28px;
    padding: 22px 28px;
  }
  summary {
    cursor: pointer;
    font-weight: 700;
    font-size: 20px;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: "+";
    color: var(--red);
    font-size: 28px;
    line-height: 0.8;
  }
  details[open] summary::after {
    content: "–";
  }
  details p {
    color: var(--soft);
    margin: 10px 0 0;
    max-width: 60ch;
  }
  @media (max-width: 860px) {
    .deptgrid,
    .steps {
      grid-template-columns: 1fr;
    }
    .steps li::after {
      display: none;
    }
    .year {
      margin: 0 12px;
    }
  }
</style>
