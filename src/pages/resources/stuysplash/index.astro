---
import { getCollection } from "astro:content";
import PageSite from "@layouts/PageSite.astro";
import PageHead from "@components/redesign/PageHead.astro";

const splash = (await import("@data/stuysplash.yml")).default;
const years = (await getCollection("stuysplash")).sort((a, b) => Number(b.data.year) - Number(a.data.year));
---

<PageSite
  title={`StuySplash ${splash.year}`}
  description={`StuySplash, StuyPulse's free day of talks for FRC teams, is on ${splash.date}. Sign up to attend or to give a talk.`}
  image="/home/stuysplash.jpg"
  fullBleed
>
  <PageHead title={`StuySplash ${splash.year}`} intro={splash.summary}>
    <span slot="before" class="chip chip-white">{splash.date}, {splash.time}</span>
    <div class="actions">
      {splash.attendForm && <a class="pill pill-white" href={splash.attendForm}>Sign up to attend</a>}
      {splash.presentForm && <a class="pill pill-ghost" href={splash.presentForm}>Give a talk</a>}
    </div>
  </PageHead>

  <section class="band about" aria-labelledby="what">
    <div>
      <h2 id="what" class="band-title">What it is</h2>
      <p>
        StuySplash is a day of classes for FRC teams, from the basics of a robot to marketing and strategy. Several talks run
        at once all day, so you can pick what's useful for your team. It grew out of the beta seminar StuyPulse ran for
        years, and became its own event in 2012, modeled on CSplash and MIT Splash.
      </p>
      {splash.lastYear && <p>{splash.lastYear}</p>}
    </div>
    <img src="/home/stuysplash.jpg" alt="A StuySplash talk in a Stuyvesant lecture hall" loading="lazy" />
  </section>

  <section class="band past" aria-labelledby="past">
    <h2 id="past" class="band-title">Past talks</h2>
    <p class="lede">Slides and recordings from every StuySplash since 2012.</p>
    <ul>
      {years.map((entry) => (
        <li>
          <a href={`/resources/stuysplash/${entry.slug}/`}>
            <b>{entry.data.year}</b>
            <span>{entry.data.presentations.length} talks</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</PageSite>

<style>
  .chip {
    margin-bottom: 18px;
  }
  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
    max-width: 1240px;
  }
  .about p {
    margin: 16px 0 0;
    font-size: 18px;
  }
  .about img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
  }
  .past {
    padding-top: 0;
  }
  .past ul {
    list-style: none;
    padding: 0;
    margin: 36px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 14px;
  }
  .past a {
    display: flex;
    flex-direction: column;
    padding: 22px 24px;
    border-radius: var(--radius-md);
    background: var(--blush);
    color: var(--ink);
  }
  .past a:hover {
    background: var(--red);
    color: #fff;
  }
  .past b {
    font-size: 32px;
    letter-spacing: -0.03em;
    font-variation-settings: "opsz" 96;
  }
  .past span {
    font-size: 15px;
    opacity: 0.8;
  }
  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
    }
  }
</style>
