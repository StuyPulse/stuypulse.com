---
import PageSite from "@layouts/PageSite.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const stuySplashEntries = await getCollection("stuysplash");

  return stuySplashEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
// The page itself is laid out by src/layouts/StuySplash.astro.
const { Content } = await entry.render();
---

<PageSite
  title={`StuySplash ${entry.data.year} talks`}
  description={`Slides from the ${entry.data.presentations.length} talks at StuySplash ${entry.data.year}, StuyPulse's free day of talks for FRC teams.`}
  fullBleed
>
  <Content />
</PageSite>
