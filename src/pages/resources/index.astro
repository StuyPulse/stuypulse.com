---
import PageSite from "@layouts/PageSite.astro";
import PageHead from "@components/redesign/PageHead.astro";

type Doc = { name: string; text?: string; href: string };
const groups: { id: string; title: string; intro: string; docs: Doc[] }[] = [
  {
    id: "members",
    title: "For new members",
    intro: "To join the team, complete these forms, pay the $200 team dues and pass the safety exam.",
    docs: [
      { name: "Media consent form", href: "https://drive.google.com/file/d/1vqRcrqGt89DYi_p43XDBxM0iFZI3wF6X/view" },
      { name: "Medical form", href: "https://drive.google.com/file/d/1X1JhrtUJzZqmVKH_vOXHZXnsaIlKAWZ0/view" },
      {
        name: "FIRST registration (STIMS)",
        text: "Make a FIRST account, then fill out the Student Team Information Management System form.",
        href: "https://www.firstinspires.org/resource-library/youth-registration-system",
      },
      {
        name: "Stuyvesant Robotics Google group",
        text: "Ask to join for weekly emails and updates.",
        href: "https://groups.google.com/g/stuyvesant-robotics",
      },
      { name: "Team charter", text: "How the team is structured and governed.", href: "/resources/charter" },
    ],
  },
  {
    id: "teams",
    title: "For other teams",
    intro: "Everything we make is open to other teams.",
    docs: [
      { name: "StuySplash talks", text: "Slides and recordings from our yearly day of talks.", href: "/resources/stuysplash" },
      { name: "Tutorials", text: "Driver Station troubleshooting and more.", href: "/resources/tutorials" },
      { name: "FLL curriculum", text: "For new FIRST LEGO League teams and mentors.", href: "/resources/tutorials/fll" },
      { name: "Our code on GitHub", text: "Robot code, this website and more, all open source.", href: "https://github.com/StuyPulse" },
    ],
  },
  {
    id: "business",
    title: "Business and outreach",
    intro: "Reference documents for the Business department.",
    docs: [
      { name: "Business handbook", href: "https://docs.google.com/document/d/1Ux0dfLKpGtqXlb2SsOtK4-jNXrZuqW6jahB4BVWtoSk/edit?usp=sharing" },
      { name: "Business reference systems (Canva)", href: "https://www.canva.com/design/DAHDBpqFE84/HOfOwDbMR6St9QCCCz5kQQ/edit" },
      { name: "Planning StuySplash", href: "https://docs.google.com/document/d/1_WFPW0PJ5OXG69ChWYiQT_TQuleCBCqmf9grueBakps/edit?usp=sharing" },
      { name: "Planning Extravaganza (team dinner)", href: "https://docs.google.com/document/d/1MGm3FYnVx2E1P8gT0mwl2mFB2yoDp4eu_fKT-ab7tQo/edit?usp=sharing" },
      { name: "Branding guide (2016–17)", text: "Our team name, logo and colors.", href: "https://old.stuypulse.com/downloads/teamdocs/BrandingGuide2016-2017.pdf" },
    ],
  },
];
---

<PageSite title="Resources" description="Forms for new StuyPulse members, guides for other teams, and Business department documents." fullBleed>
  <PageHead title="Resources" intro="Forms for new members, guides for other teams and documents for the Business department.">
    <ul class="jump">
      {groups.map((group) => <li><a href={`#${group.id}`}>{group.title}</a></li>)}
    </ul>
  </PageHead>

  {groups.map((group) => (
    <section class="band group" id={group.id} aria-labelledby={`${group.id}-title`}>
      <h2 id={`${group.id}-title`} class="band-title">{group.title}</h2>
      <p class="lede">{group.intro}</p>
      <ul class="docs">
        {group.docs.map((doc) => (
          <li>
            <a href={doc.href}>
              <b>{doc.name}</b>
              {doc.text && <span>{doc.text}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</PageSite>

<style>
  .jump {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .jump a {
    display: inline-block;
    padding: 9px 16px;
    border-radius: 999px;
    color: #fff;
    font-weight: 600;
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.7);
  }
  .jump a:hover {
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
  }
  .group {
    scroll-margin-top: 16px;
  }
  .group + .group {
    padding-top: 0;
  }
  .docs {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 14px;
  }
  .docs a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
    padding: 24px 26px;
    border-radius: var(--radius-md);
    background: var(--blush);
    color: var(--ink);
  }
  .docs a:hover {
    background: var(--red);
    color: #fff;
  }
  .docs b {
    font-size: 20px;
    line-height: 1.2;
  }
  .docs span {
    font-size: 16px;
    opacity: 0.8;
  }
</style>
