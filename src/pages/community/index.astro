---
import PageSite from "@layouts/PageSite.astro";
import Hero from "@components/page/Hero.astro";

// FLL places we've worked with, from the copy that used to sit in plain cards.
const places = [
  { name: "Williamsburg", text: "An FLL Challenge program for the past three years" },
  { name: "Bensonhurst", text: "SPIKE Prime summer camps, and four teams mentored" },
  { name: "Battery Park City", text: "An FLL Explore team, three years running" },
  { name: "Chinatown", text: "SPIKE Prime summer camps for two years" },
  { name: "MoMath", text: "A summer program in 2024" },
  { name: "Puerto Rico", text: "Mentoring teams since 2018" },
];
---

<PageSite
  title="Community"
  description="How StuyPulse gives back: robot demos, FLL mentoring and camps, and helping other FRC teams."
  image="/community/BPC_Demo.jpg"
>
  <Hero
    title="Giving back."
    intro="We demo robots, run FLL camps and help other teams, sharing what we know with schools and students across New York City and beyond."
    photo="/community/BPC_Demo.jpg"
    photoAlt="A StuyPulse robot demo in Battery Park City for STEAM Day"
    stickers={["Demos", "FLL camps", "Since 2001"]}
  >
    <Fragment slot="actions">
      <a class="pill pill-red" href="#fll">FLL programs</a>
      <a class="pill pill-line" href="/resources">Resources for teams</a>
    </Fragment>
  </Hero>

  <section class="band split" aria-labelledby="school">
    <div class="prose">
      <h2 id="school" class="band-title">At Stuyvesant</h2>
      <p>
        After our rookie year, Stuyvesant started an Intro to Robotics class, taught by our head coach and mentor,
        Joseph Blay. It's still open to juniors and seniors, and it got several other schools thinking about a course of
        their own.
      </p>
      <p>
        We demo robots at alumni reunions, giving tours of the lab and showing what we've built. At the 2025 Open House
        we showed Aunt Mary, our 2025 robot, to hundreds of incoming freshmen and their parents. We hope robotics
        becomes one of their reasons for choosing Stuy.
      </p>
    </div>
    <img
      src="/community/Open_House.jpg"
      alt="New students and parents at Stuyvesant's Open House looking at Aunt Mary"
      loading="lazy"
    />
  </section>

  <section class="band band-tint split reverse" aria-labelledby="demos">
    <img src="/home/stuysplash.jpg" alt="Students listening to a talk in the Stuyvesant robotics lab" loading="lazy" />
    <div class="prose">
      <h2 id="demos" class="band-title">Demos and media</h2>
      <p>
        In February 2025 we were on the FRC Open Alliance show, explaining our robot's mechanisms, and FUN Robotics
        named us an FRC Team of the Week for our Open Alliance work. In summer 2025 we alpha-tested SystemCore and
        presented what we learned at NYC Robo Replay, StuySplash and the NYC FIRST Kickoff.
      </p>
      <p>
        We've demoed robots at the local senior center, where our members also volunteer to help older adults with tech.
        At the NYC FIRST STEM Center we showed our 2024 offseason robot to students visiting from Japan, and smaller
        robots to Pre-K through 5th graders.
      </p>
    </div>
  </section>

  <section class="fll" id="fll" aria-labelledby="fll-title">
    <h2 id="fll-title">FIRST LEGO League</h2>
    <p class="lead">
      Since 2001 we've helped younger students take their first steps into engineering through FLL. It's still one of
      the main ways we share STEM.
    </p>
    <ul class="board">
      {
        places.map((place, i) => (
          <li style={`--i:${i};--tilt:${[-2, 1.5, -1, 2, -1.5, 1][i % 6]}deg`}>
            <span class="pin" aria-hidden="true" />
            <b>{place.name}</b>
            <span>{place.text}</span>
          </li>
        ))
      }
    </ul>
    <p class="lead">We also helped Queens team 4017, the RoboPandas, get ready for competition.</p>
    <div class="actions"><a class="pill pill-white" href="/resources/tutorials/fll">Our FLL curriculum</a></div>
  </section>

  <section class="band split" aria-labelledby="teams">
    <div class="prose">
      <h2 id="teams" class="band-title">Helping other teams</h2>
      <p>
        We're always ready to help other teams, in build season or at competitions. We visit teams and invite them to
        our lab to share what we know about safety, organization, fundraising, engineering and software. At competitions
        we send members to help fix robots, and cheer when our friends win awards or reach the finals.
      </p>
      <p>Many of those teams have become lasting friends.</p>
      <div class="actions">
        <a class="pill pill-red" href="/resources">Resources for teams</a>
        <a class="pill pill-line" href="/resources/stuysplash">StuySplash</a>
      </div>
    </div>
    <img src="/community/Stuy_Balta.jpg" alt="Team BALTA visiting the Stuyvesant robotics lab" loading="lazy" />
  </section>
</PageSite>

<style>
  .split {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }
  /* Two white sections in a row share one gap; tinted bands always keep their full padding. */
  .split:not(.band-tint) + .split:not(.band-tint) {
    padding-top: 0;
  }
  .split.reverse {
    grid-template-columns: 1fr 1.1fr;
  }
  .split h2 {
    margin-top: 0;
  }
  .split img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
  }
  /* Same inset as the tinted bands, so stacked rounded blocks sit 20px apart. */
  .fll {
    margin: var(--inset);
    padding: clamp(56px, 7vw, 96px) var(--block-pad);
    border-radius: var(--radius-lg);
    background: var(--red);
    color: #fff;
  }
  .fll h2 {
    font-size: clamp(2.4rem, 5vw, 4.4rem);
    margin: 0;
  }
  .lead {
    font-size: 19px;
    max-width: 56ch;
    margin: 18px 0 0;
    opacity: 0.94;
  }
  /* FLL places as cards pinned to a board, each pin pulsing in turn. */
  .board {
    list-style: none;
    padding: 0;
    margin: 48px 0 32px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 36px 20px;
  }
  .board li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 26px 56px 26px 28px;
    border-radius: var(--radius-md);
    background: #fff;
    color: var(--ink);
    transform: rotate(var(--tilt));
    box-shadow: 0 24px 40px -26px rgba(60, 0, 4, 0.7);
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .board li:nth-child(even) {
    background: var(--blush);
  }
  .board li:hover {
    transform: rotate(0deg) scale(1.03);
  }
  .pin {
    position: absolute;
    top: 18px;
    right: 22px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--red);
    box-shadow: 0 3px 6px rgba(60, 0, 4, 0.35);
  }
  .pin::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--red);
    opacity: 0;
    animation: ping 2s calc(var(--i) * 0.33s) ease-out infinite;
  }
  @keyframes ping {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    70%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pin::after {
      animation: none;
    }
  }
  .board b {
    color: var(--red);
    font-size: clamp(24px, 2.4vw, 30px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-variation-settings: "opsz" 96;
  }
  .board li span:last-child {
    color: var(--soft);
    font-size: 17px;
    line-height: 1.4;
  }
  @media (max-width: 1000px) {
    .board {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .board {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
  @media (max-width: 860px) {
    .split,
    .split.reverse {
      grid-template-columns: 1fr;
    }
    .split.reverse img {
      order: 1;
    }
  }
</style>
