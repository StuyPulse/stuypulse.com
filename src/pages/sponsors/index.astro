---
import PageSite from "@layouts/PageSite.astro";
import Hero from "@components/redesign/Hero.astro";
import type { SponsorType, SponsorTierType } from "@types";

const sponsors: (SponsorType & { tier: string })[] = (await import("@data/sponsors.yml")).default;
const tiers: SponsorTierType[] = (await import("@data/sponsorTiers.yml")).default;
const groups = tiers
  .map((tier) => ({ tier, sponsors: sponsors.filter((sponsor) => sponsor.tier === tier.name.toLowerCase()) }))
  .filter((group) => group.sponsors.length);
const PACKET = "https://drive.google.com/file/d/1TUDwRB274pog-uMfWDgk21ChS-UlShE-/view?usp=drivesdk";
---

<PageSite
  title="Sponsors"
  description="StuyPulse Robotics can function and participate in FIRST due to the generous support of our many sponsors. All donations support the team and help to keep it running."
  fullBleed
>
  <Hero
    title="Help us build the next one."
    intro="Our robots, competitions and StuySplash are made possible by parents, alumni and companies who support what Stuy students build."
    photo="/home/tribecbot.jpg"
    photoAlt="Tribecbot, our 2026 robot"
    stickers={["Your logo here"]}
  >
    <Fragment slot="actions">
      <a class="pill pill-white" href="/donate">Donate</a>
      <a class="pill pill-ghost" href={PACKET} target="_blank" rel="noopener noreferrer">Get our sponsor packet</a>
    </Fragment>
  </Hero>

  <section class="section" id="info" aria-labelledby="t-title">
    <h2 id="t-title">Sponsor levels</h2>
    <p class="lede">What each level of support gets.</p>
    <div class="tiers">
      {tiers.map((tier, i) => (
        <div class:list={["tier", { top: i === 0 }]}>
          <img src={tier.icon} alt="" />
          <b>{tier.name}</b>
          <span class="amt">{tier.range}</span>
          <p>{tier.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section thanks" aria-labelledby="s-title">
    <h2 id="s-title">Thank you to our sponsors</h2>
    {groups.map(({ tier, sponsors }) => (
      <div class="group">
        <h3><img src={tier.icon} alt="" />{tier.name}</h3>
        <ul class="logos">
          {sponsors.map((sponsor) => (
            <li>
              <a
                href={sponsor.site || undefined}
                target={sponsor.site ? "_blank" : undefined}
                rel="noopener noreferrer"
              >
                {sponsor.logo ? <img src={sponsor.logo} alt={sponsor.name} loading="lazy" /> : sponsor.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <section class="ask section" aria-labelledby="g-title">
    <div>
      <h2 id="g-title">Any amount helps.</h2>
      <p class="lede">Donations pay for robot parts, tools and competition fees. To sponsor as a company, start with our packet.</p>
      <div class="actions">
        <a class="pill pill-white" href="/donate">Donate</a>
        <a class="pill pill-ghost" href={PACKET} target="_blank" rel="noopener noreferrer">Sponsor packet</a>
        <a class="pill pill-ghost" href="mailto:info@stuypulse.com">Email us</a>
      </div>
    </div>
    <img src="/home/team-2026.jpg" alt="The 2026 StuyPulse team" loading="lazy" />
  </section>
</PageSite>

<style>
  .section {
    padding: clamp(72px, 9vw, 120px) var(--gutter);
  }
  h2 {
    font-size: clamp(2.3rem, 4.4vw, 4rem);
    margin: 0;
  }
  .tiers {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
    margin-top: 44px;
  }
  .tier {
    border-radius: 32px;
    background: var(--blush);
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .tier img {
    width: 52px;
    height: 52px;
  }
  .tier b {
    font-size: 24px;
    letter-spacing: -0.02em;
  }
  .amt {
    font-weight: 800;
    font-size: 20px;
    color: var(--red);
  }
  .tier p {
    color: var(--soft);
    font-size: 16px;
    line-height: 1.45;
    margin: 0;
  }
  .tier.top {
    background: var(--red);
    color: #fff;
  }
  .tier.top .amt,
  .tier.top p {
    color: #fff;
  }
  .thanks {
    padding-top: 0;
  }
  .group {
    margin-top: 48px;
  }
  .group h3 {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 28px;
    margin: 0;
  }
  .group h3 img {
    width: 36px;
  }
  .logos {
    list-style: none;
    padding: 0;
    margin: 20px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .logos a {
    display: grid;
    place-items: center;
    min-height: 88px;
    padding: 0 28px;
    border-radius: 999px;
    background: var(--blush);
    color: var(--ink);
    font-weight: 700;
  }
  .logos img {
    max-height: 50px;
    max-width: 170px;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  .ask {
    margin: 0 20px;
    border-radius: var(--radius-lg);
    background: var(--red);
    color: #fff;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 40px;
    align-items: center;
  }
  .ask .lede {
    color: #fff;
    opacity: 0.92;
  }
  .ask img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 32px;
    box-shadow: 0 30px 60px -24px rgba(70, 0, 4, 0.55);
  }
  @media (max-width: 1100px) {
    .tiers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 860px) {
    .tiers,
    .ask {
      grid-template-columns: 1fr;
    }
    .ask {
      margin: 0 12px;
    }
  }
</style>
