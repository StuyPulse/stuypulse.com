---
import PageSite from "@layouts/PageSite.astro";
import Hero from "@components/page/Hero.astro";
import { sponsors, sponsorTiers } from "@data";

const groups = sponsorTiers
  .map((tier) => ({ tier, sponsors: sponsors.filter((sponsor) => sponsor.tier === tier.name.toLowerCase()) }))
  .filter((group) => group.sponsors.length);
// Lowest level first, so the levels climb left to right like stairs.
const climb = [...sponsorTiers].reverse();
const PACKET = "https://drive.google.com/file/d/1TUDwRB274pog-uMfWDgk21ChS-UlShE-/view?usp=drivesdk";
---

<PageSite
  title="Sponsors"
  description="StuyPulse Robotics can function and participate in FIRST due to the generous support of our many sponsors. All donations support the team and help to keep it running."
>
  <Hero
    title="Help us build the next one."
    intro="Our robots, competitions and StuySplash are made possible by parents, alumni and companies who support what Stuy students build."
    photo="/team/2026.jpg"
    photoAlt="The 2026 StuyPulse team"
    stickers={["Your logo here"]}
  >
    <Fragment slot="actions">
      <a class="pill pill-red" href="/donate">Donate</a>
      <a class="pill pill-line" href={PACKET} target="_blank" rel="noopener noreferrer">Get our sponsor packet</a>
    </Fragment>
  </Hero>

  <section class="ladder on-red" id="info" aria-labelledby="t-title">
    <div class="ladder-head">
      <h2 id="t-title">Sponsor levels</h2>
      <p class="lede">What each level of support gets, from the first rung to the top.</p>
    </div>
    <ol class="rungs">
      {
        climb.map((tier, i) => (
          <li style={`--step: ${i}`} class:list={{ top: i === climb.length - 1 }}>
            <div class="tier">
              <span class="medal">
                <img src={tier.icon} alt="" />
              </span>
              <b>{tier.name}</b>
              <span class="amt">{tier.range}</span>
              <p>{tier.desc}</p>
            </div>
            <span class="riser" aria-hidden="true" />
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section thanks" aria-labelledby="s-title">
    <h2 id="s-title">Thank you to our sponsors</h2>
    {
      groups.map(({ tier, sponsors }) => (
        <div class="group">
          <h3>
            <span class="medal small">
              <img src={tier.icon} alt="" />
            </span>
            {tier.name}
          </h3>
          <ul class="logos">
            {sponsors.map((sponsor) => (
              <li>
                <a
                  href={sponsor.site || undefined}
                  target={sponsor.site ? "_blank" : undefined}
                  rel="noopener noreferrer"
                >
                  {sponsor.logo ? <img src={sponsor.logo} alt={sponsor.name} loading="lazy" /> : sponsor.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>

  <section class="ask section" aria-labelledby="g-title">
    <div>
      <h2 id="g-title">Any amount helps.</h2>
      <p class="lede">
        Donations pay for robot parts, tools and competition fees. To sponsor as a company, start with our packet.
      </p>
      <div class="actions">
        <a class="pill pill-red" href="/donate">Donate</a>
        <a class="pill pill-line" href={PACKET} target="_blank" rel="noopener noreferrer">Sponsor packet</a>
        <a class="pill pill-line" href="mailto:info@stuypulse.com">Email us</a>
      </div>
    </div>
    <img src="/home/tribecbot.jpg" alt="Tribecbot, our 2026 robot" loading="lazy" />
  </section>
</PageSite>

<style>
  .section {
    padding: clamp(72px, 9vw, 120px) var(--gutter);
  }
  h2 {
    font-size: clamp(2.3rem, 4.4vw, 4rem);
    margin: 0;
  }
  /* The levels as a staircase on red: each rung stands on a taller riser than the one before. */
  .ladder {
    margin: clamp(32px, 4vw, 56px) var(--inset) 0;
    padding: clamp(56px, 7vw, 96px) var(--block-pad) 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .ladder h2 {
    color: #fff;
  }
  .rungs {
    list-style: none;
    padding: 0;
    margin: 48px 0 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    align-items: end;
    gap: 14px;
  }
  .rungs li {
    display: flex;
    flex-direction: column;
  }
  .riser {
    display: block;
    height: calc(28px + var(--step) * clamp(36px, 5vw, 64px));
    margin-top: 14px;
    border-radius: 24px 24px 0 0;
    background: rgba(120, 0, 8, 0.32);
  }
  .tier {
    border-radius: 32px;
    background: #fff;
    color: var(--ink);
    padding: 26px 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: transform 0.2s ease;
  }
  .tier:hover {
    transform: translateY(-6px);
  }
  /* Medals sit on a disc so the lighter ones (silver, aluminum) stay visible. */
  .medal {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--blush);
    flex-shrink: 0;
  }
  .medal img {
    width: 40px;
    height: 40px;
  }
  .tier:hover .medal {
    animation: wobble 0.3s ease-in-out;
  }
  @keyframes wobble {
    25% {
      transform: rotate(-8deg);
    }
    75% {
      transform: rotate(8deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tier:hover {
      transform: none;
    }
    .tier:hover .medal {
      animation: none;
    }
  }
  .tier b {
    font-size: 24px;
    letter-spacing: -0.02em;
  }
  .amt {
    font-weight: 800;
    font-size: 20px;
    color: var(--red);
  }
  .tier p {
    color: var(--soft);
    font-size: 16px;
    line-height: 1.45;
    margin: 0;
  }
  .top .tier {
    box-shadow:
      0 0 0 4px var(--red),
      0 0 0 8px #fff;
  }
  .top .riser {
    background: rgba(120, 0, 8, 0.45);
  }
  .thanks {
    padding-bottom: clamp(48px, 6vw, 80px);
  }
  .group {
    margin-top: 48px;
  }
  .group h3 {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 28px;
    margin: 0;
  }
  .medal.small {
    width: 44px;
    height: 44px;
  }
  .medal.small img {
    width: 28px;
    height: 28px;
  }
  .logos {
    list-style: none;
    padding: 0;
    margin: 20px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .logos a {
    display: grid;
    place-items: center;
    min-height: 88px;
    padding: 0 28px;
    border-radius: 999px;
    background: var(--blush);
    color: var(--ink);
    font-weight: 700;
  }
  .logos img {
    max-height: 50px;
    max-width: 170px;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  .ask {
    margin: 0 var(--inset);
    padding: clamp(56px, 7vw, 96px) var(--block-pad);
    border-radius: var(--radius-lg);
    background: var(--blush);
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 40px;
    align-items: center;
  }

  .ask img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 32px;
    box-shadow: 0 30px 60px -24px rgba(70, 0, 4, 0.55);
  }
  /* Move the hero's "Your logo here" sticker in from the corner of the red block. */
  :global(.hero .photo .s1) {
    right: 28px;
    top: -18px;
  }
  /* Too narrow for five steps side by side: the ladder stands upright, top level first,
     each step up sitting a little further right. */
  @media (max-width: 1000px) {
    .ladder {
      padding-bottom: clamp(40px, 6vw, 64px);
    }
    .rungs {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .rungs li {
      order: calc(10 - var(--step));
      margin-left: calc(var(--step) * 12px);
    }
    .riser {
      display: none;
    }
  }
  @media (max-width: 860px) {
    .ask {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .logos {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }
    .logos a {
      height: 100%;
      min-height: 76px;
      padding: 10px 14px;
      border-radius: 24px;
      text-align: center;
      font-size: 15px;
      line-height: 1.25;
    }
    .logos img {
      max-width: 100%;
      max-height: 40px;
    }
  }
</style>
