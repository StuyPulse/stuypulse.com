---
import { getCollection } from "astro:content";
import PageSite from "@layouts/PageSite.astro";
import Hero from "@components/redesign/Hero.astro";
import Heartbeat from "@components/redesign/Heartbeat.astro";
import getSortedPosts from "@utils/getSortedPosts";
import type { SponsorType } from "@types";

const latestPost = getSortedPosts(await getCollection("news"))[0];
const splash = (await import("@data/stuysplash.yml")).default;
const robots = await getCollection("history");

const sponsors: (SponsorType & { tier: string })[] = (await import("@data/sponsors.yml")).default;
const tierOrder = ["platinum", "gold", "silver", "bronze", "aluminum"];
const sponsorLogos = sponsors
  .filter((sponsor) => sponsor.logo)
  .sort((a, b) => tierOrder.indexOf(a.tier) - tierOrder.indexOf(b.tier))
  .slice(0, 8);

const departments = [
  { name: "Mechanical", icon: "/icons/mechanical.svg" },
  { name: "Software", icon: "/icons/software.svg" },
  { name: "Business", icon: "/icons/business.svg" },
  { name: "Strategy", icon: "/icons/strategy.svg" },
];
---

<PageSite
  title="Home"
  description="Team 694 is an award-winning FIRST robotics team from New York City. Find out about our team, its history, and view pictures and videos."
  showBanner
  fullBleed
>
  <Hero
    title="Find your pulse."
    intro="We're FIRST Robotics Team 694 from Stuyvesant High School. Students design, build, program and fund a new robot every year."
    photo="/home/team-2026.jpg"
    photoAlt="The 2026 StuyPulse team"
    stickers={["No cuts", "No tryouts", "Since 2001"]}
  >
    <Fragment slot="actions">
      <a class="pill pill-white" href="/join">Join the team</a>
      <a class="pill pill-ghost" href="/sponsors">Support us</a>
    </Fragment>
  </Hero>

  <section class="section" aria-labelledby="beat-title">
    <div class="head">
      <div>
        <h2 id="beat-title">{robots.length} seasons, one heartbeat.</h2>
        <p class="lede">Each spike is a season. The taller it is, the more awards that robot brought home. Point at one to see it.</p>
      </div>
      <a class="pill pill-line" href="/about/history">See every robot</a>
    </div>
    <Heartbeat photoYears={[2001, 2005, 2010, 2016, 2019, 2022, 2026]} />
  </section>

  <div class:list={["tiles", { solo: !splash.showOnHome }]}>
    {splash.showOnHome && (
      <article class="tile tile-red" id="stuysplash">
        <span class="big" aria-hidden="true">{splash.shortDate}</span>
        <span class="chip chip-white">{splash.date}, {splash.time}</span>
        <h2>StuySplash {splash.year}</h2>
        <p>{splash.summary} {splash.lastYear}</p>
        <div class="actions">
          {splash.attendForm && <a class="pill pill-white" href={splash.attendForm}>Sign up to attend</a>}
          {splash.presentForm && <a class="pill pill-ghost" href={splash.presentForm}>Give a talk</a>}
          <a class="pill pill-ghost" href="/resources/stuysplash">Past talks</a>
        </div>
      </article>
    )}
    <article class="tile tile-blush" id="news">
      <div class="faces">
        <img src="/community/Open_House.jpg" alt="" />
        <img src="/community/BPC_Demo.jpg" alt="" />
        <img src="/community/Stuy_Balta.jpg" alt="" />
      </div>
      <h2>What we've been up to</h2>
      <p>Our newsletters cover build updates, competition results and who's new on the team.{latestPost && <> The latest is <strong>{latestPost.data.title}</strong>.</>}</p>
      <div class="actions">
        {latestPost && <a class="pill pill-red" href={latestPost.data.link || `/news/${latestPost.slug}`}>Read the latest</a>}
        <a class="pill pill-line" href="/news">All newsletters</a>
      </div>
    </article>
  </div>

  <section class="join section" aria-labelledby="join-title">
    <h2 id="join-title">No cuts. No tryouts.</h2>
    <p class="lede">If you go to Stuy and you're curious, there's a spot for you. Pick a department, or try them all.</p>
    <div class="depts">
      {departments.map((dept) => (
        <a class="dept" href={`/join#${dept.name.toLowerCase()}`}>
          <i><img src={dept.icon} alt="" /></i>
          <b>{dept.name}</b>
        </a>
      ))}
    </div>
    <div class="actions center"><a class="pill pill-white" href="/join">How to join</a></div>
  </section>

  <section class="section" aria-labelledby="sp-title">
    <div class="head">
      <div>
        <h2 id="sp-title">Built with help from</h2>
        <p class="lede">Parents, alumni and companies who keep the lab running.</p>
      </div>
      <a class="pill pill-red" href="/sponsors">Become a sponsor</a>
    </div>
    <ul class="logos">
      {sponsorLogos.map((sponsor) => (
        <li>
          <a href={sponsor.site || "/sponsors"} target={sponsor.site ? "_blank" : undefined} rel="noopener noreferrer">
            <img src={sponsor.logo} alt={sponsor.name} loading="lazy" />
          </a>
        </li>
      ))}
    </ul>
  </section>
</PageSite>

<style>
  .section {
    padding: clamp(72px, 9vw, 120px) var(--gutter);
  }
  h2 {
    font-size: clamp(2.3rem, 4.4vw, 4rem);
    margin: 0;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    flex-wrap: wrap;
  }

  .tiles {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 20px;
    padding: 0 20px;
  }
  .tiles.solo {
    grid-template-columns: 1fr;
  }
  .tile {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    padding: clamp(32px, 4vw, 52px);
    min-height: 460px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
  }
  .tile p {
    margin: 14px 0 0;
    font-size: 19px;
    max-width: 40ch;
  }
  .tile .chip {
    margin-bottom: 18px;
  }
  .tile .actions {
    margin-top: 26px;
  }
  .tile-red {
    background: var(--red);
    color: #fff;
  }
  .tile-blush {
    background: var(--blush);
  }
  .tile-blush p {
    color: var(--soft);
  }
  .big {
    position: absolute;
    right: 36px;
    top: 20px;
    font-weight: 800;
    font-size: clamp(120px, 15vw, 220px);
    line-height: 1;
    letter-spacing: -0.06em;
    opacity: 0.17;
    font-variation-settings: "opsz" 96;
  }
  .faces {
    display: flex;
    margin-bottom: auto;
    padding-bottom: 28px;
  }
  .faces img {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    border: 5px solid var(--blush);
    margin-right: -22px;
  }

  .join {
    margin: 20px;
    border-radius: var(--radius-lg);
    background: var(--red);
    color: #fff;
    text-align: center;
  }
  .join h2 {
    font-size: clamp(3rem, 7vw, 6.4rem);
  }
  .join .lede {
    margin: 18px auto 0;
    color: #fff;
    opacity: 0.92;
  }
  .depts {
    display: flex;
    justify-content: center;
    gap: clamp(16px, 3vw, 32px);
    margin-top: 56px;
    flex-wrap: wrap;
  }
  .dept {
    width: 170px;
    color: #fff;
  }
  .dept:hover {
    color: #fff;
  }
  .dept i {
    display: grid;
    place-items: center;
    width: 112px;
    height: 112px;
    margin: 0 auto;
    border-radius: 50%;
    background: #fff;
    transition: transform 0.2s ease;
  }
  .dept:hover i {
    transform: translateY(-4px);
  }
  .dept img {
    width: 54px;
    height: 54px;
  }
  .dept b {
    display: block;
    margin-top: 14px;
    font-size: 20px;
  }
  .actions.center {
    justify-content: center;
    margin-top: 52px;
  }

  .logos {
    list-style: none;
    padding: 0;
    margin: 40px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .logos a {
    display: grid;
    place-items: center;
    height: 96px;
    padding: 0 28px;
    border-radius: 999px;
    background: var(--blush);
  }
  .logos img {
    max-height: 54px;
    max-width: 170px;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  @media (max-width: 860px) {
    .tiles {
      grid-template-columns: 1fr;
      padding: 0 12px;
    }
    .tile {
      min-height: 0;
    }
    .join {
      margin: 12px;
    }
    .depts {
      gap: 24px 12px;
    }
    .dept {
      width: calc(50% - 6px);
    }
    .dept i {
      width: 88px;
      height: 88px;
    }
    .dept img {
      width: 42px;
      height: 42px;
    }
  }
</style>
