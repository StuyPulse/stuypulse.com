---
import PageSite from "@layouts/PageSite.astro";
import PageHead from "@components/redesign/PageHead.astro";

const board: { name: string; role: string }[] = (await import("@data/board.yml")).default;
const initials = (name: string) => name.split(/\s+/).map((part) => part[0]).join("").slice(0, 3);
---

<PageSite title="Board of Directors" description="Meet the board of the StuyPulse nonprofit organization." fullBleed>
  <PageHead title="Board of Directors" intro="The volunteers who run StuyPulse's nonprofit, which holds the team's funds and sponsorships." />

  <ul class="band board">
    {board.map((member) => (
      <li>
        <span class="face" aria-hidden="true">{initials(member.name)}</span>
        <b>{member.name}</b>
        <span>{member.role}</span>
      </li>
    ))}
  </ul>
</PageSite>

<style>
  .board {
    list-style: none;
    margin: 0;
    max-width: 1120px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 40px 24px;
  }
  li {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .face {
    display: grid;
    place-items: center;
    width: 112px;
    height: 112px;
    margin-bottom: 14px;
    border-radius: 50%;
    background: var(--blush);
    color: var(--red);
    font-weight: 800;
    font-size: 34px;
    letter-spacing: -0.03em;
    font-variation-settings: "opsz" 96;
  }
  b {
    font-size: 23px;
    letter-spacing: -0.01em;
  }
  li > span:last-child {
    color: var(--soft);
  }
</style>
