---
import PageSite from "@layouts/PageSite.astro";
import RobotPage from "@components/robots/RobotPage.astro";
import { plural } from "@utils/format";
import { getRobots, type Robot } from "@utils/robots";

export async function getStaticPaths() {
  const robots = await getRobots();
  return robots.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props as { entry: Robot };
const { title, year, awards, photo } = entry.data;
const { Content } = await entry.render();
---

<PageSite
  title={`${title}, our ${year} robot`}
  description={`${title} was StuyPulse's ${year} robot${awards?.length ? `, with ${plural(awards.length, "award")}` : ""}.`}
  image={photo}
>
  <RobotPage entry={entry}>
    <Content />
  </RobotPage>
</PageSite>
