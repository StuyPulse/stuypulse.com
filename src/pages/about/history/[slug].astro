---
import PageSite from '@layouts/PageSite.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const historyEntries = await getCollection('history');
  return historyEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
// The robot page itself is laid out by src/layouts/History.astro.
const { Content } = await entry.render();
---

<PageSite
  title={`${entry.data.title}, our ${entry.data.year} robot`}
  description={`${entry.data.title} was StuyPulse's ${entry.data.year} robot${entry.data.awards?.length ? `, with ${entry.data.awards.length} awards` : ''}.`}
  image={entry.data.photo}
  fullBleed
>
  <Content />
</PageSite>
