---
import PageSite from "@layouts/PageSite.astro";
import PageHead from "@components/redesign/PageHead.astro";
import type { MentorType } from "@types";

const mentors: MentorType[] = (await import("@data/mentors.yml")).default;
const initials = (name: string) => name.split(/\s+/).map((part) => part[0]).join("").slice(0, 3);
---

<PageSite title="Mentors" description="The mentors who volunteer their time to teach and guide StuyPulse." fullBleed>
  <PageHead
    title="Mentors"
    intro="Engineers, teachers, parents and alumni who give their time to the team. Thank you to everyone who has mentored us, including:"
  />

  <ul class="band mentors">
    {mentors.map((mentor) => (
      <li>
        {mentor.image ? (
          <img class="face" src={mentor.image} alt="" loading="lazy" />
        ) : (
          <span class="face initials" aria-hidden="true">{initials(mentor.name)}</span>
        )}
        <div>
          <h2>{mentor.name}</h2>
          {mentor.description && <p>{mentor.description}</p>}
          {mentor.woodieFlowers && (
            <a class="pill pill-line" href={mentor.woodieFlowers}>Read their Woodie Flowers nomination</a>
          )}
        </div>
      </li>
    ))}
  </ul>
</PageSite>

<style>
  .mentors {
    list-style: none;
    margin: 0;
    max-width: 1120px;
    display: grid;
    gap: 56px;
  }
  li {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: clamp(20px, 4vw, 48px);
    align-items: start;
  }
  .face {
    display: grid;
    place-items: center;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--blush);
  }
  .initials {
    color: var(--red);
    font-weight: 800;
    font-size: 52px;
    letter-spacing: -0.03em;
    font-variation-settings: "opsz" 96;
  }
  h2 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    margin: 12px 0 0;
  }
  p {
    margin: 12px 0 0;
    color: var(--soft);
    max-width: 68ch;
  }
  .pill {
    margin-top: 18px;
    min-height: 44px;
    font-size: 16px;
  }
  @media (max-width: 640px) {
    li {
      grid-template-columns: 1fr;
    }
    .face {
      width: 120px;
      height: 120px;
    }
    .initials {
      font-size: 36px;
    }
  }
</style>
