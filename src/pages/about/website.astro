---
import PageSite from "@layouts/PageSite.astro";
import PageHead from "@components/redesign/PageHead.astro";
import type { LeadershipType } from "@types";

// I/T directors come straight from the leadership list, so this stays current.
const leaders: LeadershipType[] = (await import("@data/leadership.yml")).default;
const it = leaders.filter((leader) => /I\/T/.test(leader.position));
---

<PageSite title="About this website" description="How stuypulse.com is built, and who maintains it." fullBleed>
  <PageHead title="About this website" intro="stuypulse.com is built and run by students in our I/T department.">
    <div class="actions">
      <a class="pill pill-white" href="https://github.com/StuyPulse/stuypulse.com">See the source code</a>
      <a class="pill pill-ghost" href="mailto:info@stuypulse.com?subject=Website">Email I/T</a>
    </div>
  </PageHead>

  <div class="band prose">
    {it.length > 0 && (
      <>
        <h2>Who runs it</h2>
        <ul class="people">
          {it.map((leader) => <li><b>{leader.name}</b>, {leader.position.replace(/\s*\([^)]*\)$/, "")}</li>)}
        </ul>
      </>
    )}

    <h2>History</h2>
    <p>
      This version of stuypulse.com launched on August 1, 2023, replacing the Jekyll site we'd used since 2013. It was
      built in 2022 and 2023 by our then-new I/T department: Gus Watkins, Ivy Lin, Kelvin Zhao and Anthony Chen. In 2026
      it was redesigned in red and white.
    </p>

    <h2>How it's built</h2>
    <p>
      The site is built with <a href="https://astro.build">Astro</a>, a static site generator, so pages are made ahead of
      time and no server is needed. It's hosted on GitHub Pages and rebuilt by GitHub Actions every time something changes.
    </p>
    <p>
      Newsletters, robots, StuySplash talks, leadership, mentors and sponsors are kept as Markdown and YAML files. Team
      members can edit them without writing code, using the editor at <a href="/admin/">stuypulse.com/admin</a>.
    </p>
    <p>
      The whole site is open source. Take a look at the
      <a href="https://github.com/StuyPulse/stuypulse.com">source code on GitHub</a> to see how it works.
    </p>
  </div>
</PageSite>

<style>
  .prose {
    max-width: 1120px;
  }
  .prose h2:first-child {
    margin-top: 0;
  }
  .prose h2 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
  }
  .people {
    padding-left: 1.2em;
  }
</style>
