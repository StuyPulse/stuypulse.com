---
import PageSite from '@layouts/PageSite.astro';
import PageHead from '@components/redesign/PageHead.astro';
import type { AchievementsType } from '@types';

const achievements: (AchievementsType & { season?: string })[] = (await import('@data/ftcawards.yml')).default;
const teams = [
  {
    number: '310',
    name: 'Fission 310',
    site: 'https://fission310.com',
    logo: '/ftc/310_logo.png',
    photo: '/ftc/310_team.jpg',
    outreach: 'Fission works with local and global FLL teams, and mentors elementary and middle schoolers at CoderSchool.',
  },
  {
    number: '479',
    name: 'Fusion 479',
    site: 'https://fusion479.github.io/',
    logo: '/ftc/479_logo.png',
    photo: '/ftc/479_team.jpg',
    outreach: 'Fusion demos robots at elementary schools, such as P.S. 41Q, and at the FLCDC summer camp.',
  },
];
---

<PageSite title="FTC teams" description="Stuyvesant's two FIRST Tech Challenge teams, Fission 310 and Fusion 479, who share our lab." fullBleed>
  <PageHead
    title="Our FTC teams"
    intro="We share our lab with two sister FIRST Tech Challenge teams, who build smaller robots over a longer season."
  >
    <div class="actions">
      <a class="pill pill-white" href="https://www.firstinspires.org/robotics/ftc">What is FTC?</a>
    </div>
  </PageHead>

  <div class="band teams">
    {teams.map((team) => {
      const record = achievements.find((entry) => String(entry.team) === team.number);
      return (
        <section aria-labelledby={`t${team.number}`}>
          <img class="photo" src={team.photo} alt={`The ${team.name} team`} loading="lazy" />
          <div class="name">
            <img class="logo" src={team.logo} alt="" />
            <h2 id={`t${team.number}`}>{team.name}</h2>
          </div>
          <p>{team.outreach}</p>
          <a class="pill pill-red" href={team.site}>Visit their website</a>
          {record && (
            <>
              <h3>Awards{record.season ? `, ${record.season}` : ''}</h3>
              <ul class="awards">
                {record.competitions.map((competition) => (
                  <li>
                    <b>{competition.name}</b>
                    <span>{competition.awards.join(', ')}</span>
                  </li>
                ))}
              </ul>
            </>
          )}
        </section>
      );
    })}
  </div>

  <section class="band split" aria-labelledby="together">
    <div class="prose">
      <h2 id="together" class="band-title">Outreach together</h2>
      <p>
        Both FTC teams work with Stuyvesant Women Engineers to teach electrical engineering to girls interested in the field,
        and with CS Dojo, a student-run tutoring group at Stuyvesant. They're also active in FTC forums and servers, sharing
        what they've built to help new teams.
      </p>
    </div>
    <img src="/ftc/outreach.jpg" alt="FTC members teaching younger students to build robots" loading="lazy" />
  </section>
</PageSite>

<style>
  .teams {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 4vw, 56px);
  }
  .photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
  }
  .name {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 24px;
  }
  .logo {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--blush);
  }
  h2 {
    font-size: clamp(2rem, 3.4vw, 2.8rem);
    margin: 0;
  }
  section > p {
    color: var(--soft);
    margin: 16px 0 20px;
  }
  h3 {
    font-size: 22px;
    margin: 36px 0 0;
  }
  .awards {
    list-style: none;
    padding: 0;
    margin: 14px 0 0;
    display: grid;
    gap: 10px;
  }
  .awards li {
    display: flex;
    flex-direction: column;
    padding: 16px 20px;
    border-radius: 22px;
    background: var(--blush);
  }
  .awards span {
    color: var(--soft);
    font-size: 16px;
  }
  .split {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
    padding-top: 0;
  }
  .split h2 {
    margin-top: 0;
  }
  .split img {
    width: 100%;
    border-radius: var(--radius-md);
  }
  @media (max-width: 860px) {
    .teams,
    .split {
      grid-template-columns: 1fr;
    }
  }
</style>
