---
import PageSite from "@layouts/PageSite.astro";
import PageHead from "@components/page/PageHead.astro";
import { ftcTeams as achievements } from "@data";
import AwardList from "@components/awards/AwardList.astro";
import BigStat from "@components/about/BigStat.astro";
import { plural } from "@utils/format";
const teams = [
  {
    number: "310",
    name: "Fission 310",
    site: "https://fission310.com",
    logo: "/ftc/310_logo.png",
    photo: "/ftc/310_team.jpg",
    outreach:
      "Fission works with local and global FLL teams, and mentors elementary and middle schoolers at CoderSchool.",
  },
  {
    number: "479",
    name: "Fusion 479",
    site: "https://fusion479.github.io/",
    logo: "/ftc/479_logo.png",
    photo: "/ftc/479_team.jpg",
    outreach: "Fusion demos robots at elementary schools, such as P.S. 41Q, and at the FLCDC summer camp.",
  },
];

// "2022–23 (POWERPLAY)" -> "2022–23" and "POWERPLAY", so the year reads first.
const splitSeason = (season?: string) => {
  const match = season?.match(/^(.*?)\s*\((.*)\)$/);
  return match ? { years: match[1], game: match[2] } : { years: season, game: undefined };
};

// Every award on record for both teams, for the big number up top.
const awardCount = achievements.flatMap((entry) => entry.competitions.flatMap((c) => c.awards)).length;
const seasons = [...new Set(achievements.map((entry) => splitSeason(entry.season).years).filter(Boolean))];
const statLabel = `awards for Fission and Fusion${seasons.length === 1 ? ` in the ${seasons[0]} season` : ""}`;
---

<PageSite
  title="FTC teams"
  description="Stuyvesant's two FIRST Tech Challenge teams, Fission 310 and Fusion 479, who share our lab."
>
  <PageHead
    title="Our FTC teams"
    intro="We share our lab with two sister FIRST Tech Challenge teams, who build smaller robots over a longer season."
  >
    <div class="actions">
      <a class="pill pill-red" href="https://www.firstinspires.org/robotics/ftc">What is FTC?</a>
    </div>
    {
      awardCount > 0 && (
        <BigStat slot="aside" value={awardCount} label={statLabel} sticker={`${teams.length} sister teams`} />
      )
    }
  </PageHead>

  <div class="band teams">
    {
      teams.map((team) => {
        const record = achievements.find((entry) => String(entry.team) === team.number);
        const season = splitSeason(record?.season);
        return (
          <section aria-labelledby={`t${team.number}`}>
            <img class="photo" src={team.photo} alt={`The ${team.name} team`} loading="lazy" />
            <div class="name">
              <img class="logo" src={team.logo} alt="" />
              <h2 id={`t${team.number}`}>{team.name}</h2>
            </div>
            <p>{team.outreach}</p>
            <a class="pill pill-red" href={team.site}>
              Visit their website
            </a>
            {record && (
              <>
                <div class="awards-head">
                  <h3>{season.years ? `${season.years} season awards` : "Awards"}</h3>
                  {season.game && <span class="chip chip-red">{season.game}</span>}
                </div>
                <details class="record">
                  <summary>
                    <span>
                      {plural(record.competitions.length, "event")} ·{" "}
                      {plural(record.competitions.flatMap((c) => c.awards).length, "award")}
                    </span>
                    <span class="open-label">
                      <span class="when-closed">See them all</span>
                      <span class="when-open">Hide</span>
                    </span>
                    <svg class="chev" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M6 9l6 6 6-6" />
                    </svg>
                  </summary>
                  <ul class="awards">
                    {record.competitions.map((competition) => (
                      <li>
                        <b>{competition.name}</b>
                        <AwardList awards={competition.awards} size="sm" />
                      </li>
                    ))}
                  </ul>
                </details>
              </>
            )}
          </section>
        );
      })
    }
  </div>

  <section class="band band-tint split" aria-labelledby="together">
    <div class="prose">
      <h2 id="together" class="band-title">Outreach together</h2>
      <p>
        Both FTC teams work with Stuyvesant Women Engineers to teach electrical engineering to girls interested in the
        field, and with CS Dojo, a student-run tutoring group at Stuyvesant. They're also active in FTC forums and
        servers, sharing what they've built to help new teams.
      </p>
    </div>
    <img src="/ftc/outreach.jpg" alt="FTC members teaching younger students to build robots" loading="lazy" />
  </section>
</PageSite>

<style>
  .teams {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 4vw, 56px);
  }
  .photo {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
  }
  .name {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 24px;
  }
  .logo {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--blush);
  }
  h2 {
    font-size: clamp(2rem, 3.4vw, 2.8rem);
    margin: 0;
  }
  section > p {
    color: var(--soft);
    margin: 16px 0 20px;
  }
  .awards-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin-top: 36px;
  }
  h3 {
    font-size: 22px;
    margin: 0;
  }
  .awards-head .chip {
    font-size: 14px;
    padding: 4px 12px;
  }
  /* The full award list folds away behind one summary row. */
  .record {
    margin-top: 14px;
  }
  summary {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 14px 14px 24px;
    border-radius: 999px;
    background: var(--red);
    color: #fff;
    font-weight: 800;
    font-size: 19px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .open-label {
    margin-left: auto;
    font-weight: 600;
    font-size: 15px;
    opacity: 0.9;
  }
  .chev {
    flex: none;
    width: 34px;
    height: 34px;
    padding: 7px;
    border-radius: 50%;
    background: #fff;
    fill: none;
    stroke: var(--red);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s ease;
  }
  .when-open,
  .record[open] .when-closed {
    display: none;
  }
  .record[open] .when-open {
    display: inline;
  }
  .record[open] .chev {
    transform: rotate(180deg);
  }
  summary:hover {
    background: var(--red-dark);
  }
  .record[open] .awards {
    animation: unfold 0.2s ease both;
  }
  @keyframes unfold {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .record[open] .awards {
      animation: none;
    }
  }
  .awards {
    list-style: none;
    padding: 0;
    margin: 10px 0 0;
    display: grid;
    gap: 10px;
  }
  .awards > li {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 18px 20px;
    border-radius: 22px;
    background: var(--blush);
  }
  .split {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }
  .split h2 {
    margin: 0 0 20px;
  }
  .split img {
    width: 100%;
    border-radius: var(--radius-md);
  }
  @media (max-width: 640px) {
    .open-label {
      display: none;
    }
    summary > span:first-child {
      margin-right: auto;
    }
  }
  @media (max-width: 860px) {
    .teams,
    .split {
      grid-template-columns: 1fr;
    }
  }
</style>
